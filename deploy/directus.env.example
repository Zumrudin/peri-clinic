# /srv/peri/directus/.env — Directus (native install, SQLite)
HOST=127.0.0.1
PORT=8055
PUBLIC_URL=https://peri-cms.zumrudin.ru

DB_CLIENT=sqlite3
DB_FILENAME=./database/data.db

SECRET=change-me-64-random-chars
ADMIN_EMAIL=admin@peri-clinic.ru
ADMIN_PASSWORD=change-me

STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
FILES_MAX_UPLOAD_SIZE=50mb
EXTENSIONS_PATH=./extensions

TELEMETRY=false
WEBSOCKETS_ENABLED=false
RATE_LIMITER_ENABLED=true
RATE_LIMITER_POINTS=50
RATE_LIMITER_DURATION=1
CACHE_ENABLED=false
LOG_LEVEL=info

# Flows may call the rebuild receiver with these
FLOWS_ENV_ALLOW_LIST=REBUILD_URL,REBUILD_TOKEN
REBUILD_URL=http://127.0.0.1:8787/rebuild
REBUILD_TOKEN=change-me-same-as-rebuild-env

# Directus' default IMPORT_IP_DENY_LIST is ["0.0.0.0", "169.254.169.254"] — the "0.0.0.0"
# entry blocks Flow "request" operations (and file imports by URL) from reaching ANY of the
# server's own network interfaces, including 127.0.0.1. That breaks the rebuild webhook above,
# which is intentionally local. Keep the cloud metadata IP blocked, drop the "0.0.0.0" blanket rule.
IMPORT_IP_DENY_LIST=169.254.169.254

# Image transforms (thumbnails in admin)
ASSETS_TRANSFORM_MAX_CONCURRENT=2
