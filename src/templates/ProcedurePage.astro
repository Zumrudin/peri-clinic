---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import Faq from '../components/faq/Faq.astro';
import CaseCard from '../components/results/CaseCard.astro';
import PriceTable from '../components/pricing/PriceTable.astro';
import { em, telHref, whatsappHref } from '../lib/markup';
import { getSiteSettings } from '../lib/siteContent';
import { getCasesForProcedure, getFaqForProcedure, getPriceItemsForProcedure, procedureGallery } from '../lib/procedureContent';
import { directusImage } from '../lib/media';
import type { CollectionEntry } from 'astro:content';

interface Props {
  procedure: CollectionEntry<'procedures'>;
}
const { procedure: entry } = Astro.props;
const p = entry.data;

const site = await getSiteSettings();
const cases = await getCasesForProcedure(p.slug);
const faq = await getFaqForProcedure(p.slug);
const priceItems = await getPriceItemsForProcedure(p.slug);
const gallery = procedureGallery(p.gallery);
const cover = directusImage(p.cover);

const facts = [
  p.duration && { label: 'Длительность', value: p.duration },
  p.rehab && { label: 'Реабилитация', value: p.rehab },
  p.effect_duration && { label: 'Эффект', value: p.effect_duration },
  p.sessions && { label: 'Курс', value: p.sessions },
].filter(Boolean) as Array<{ label: string; value: string }>;

const waText = `Здравствуйте! Хочу записаться на «${p.title}»`;
---

<Page title={p.seo_title || `${p.title} — PERI CLINIC`} description={p.seo_description || p.summary || p.lead || ''}>
  <Breadcrumbs
    slot="head"
    items={[
      ...(p.category ? [{ name: p.category.title, href: `/${p.category.slug}` }] : []),
      { name: p.title, href: `/${p.slug}` },
    ]}
  />

  <section class="proc-hero" aria-labelledby="proc-title">
    {
      cover && (
        <div class="proc-hero__image">
          <Image src={cover.src} alt={p.cover_alt || p.title} width={900} height={1100} sizes="(max-width: 800px) 100vw, 42vw" loading="eager" fetchpriority="high" />
        </div>
      )
    }
    <div class="proc-hero__content">
      {p.category && <p class="eyebrow">{p.category.title}</p>}
      <h1 id="proc-title" set:html={em(p.title)} />
      {p.subtitle && <p class="proc-hero__subtitle">{p.subtitle}</p>}
      {p.lead && <p class="proc-hero__lead">{p.lead}</p>}
      <div class="proc-hero__actions">
        <button class="button" type="button" data-open-sheet data-context={p.title}>
          Записаться <span>↗</span>
        </button>
        <a class="text-link" href={whatsappHref(site.phone, waText)} target="_blank" rel="noopener">
          Спросить стоимость <span>↗</span>
        </a>
      </div>
      {
        facts.length > 0 && (
          <dl class="proc-hero__facts">
            {facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  {
    p.steps.length > 0 && (
      <section class="section proc-steps reveal" aria-labelledby="steps-title">
        <p class="eyebrow">Как проходит процедура</p>
        <h2 id="steps-title">Этапы визита</h2>
        <div class="proc-steps__grid">
          {p.steps.map((s, i) => (
            <article>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    p.body && (
      <section class="section proc-body reveal">
        <div class="prose" set:html={p.body} />
      </section>
    )
  }

  {
    gallery.length > 0 && (
      <section class="section proc-gallery reveal" aria-label="Фотографии">
        <div class="proc-gallery__grid">
          {gallery.map((img, i) => (
            <Image src={img.src} alt={`${p.title} — фото ${i + 1}`} width={600} height={750} sizes="(max-width: 800px) 46vw, 22vw" loading="lazy" />
          ))}
        </div>
      </section>
    )
  }

  {
    (p.indications || p.contraindications) && (
      <section class="section proc-medical reveal">
        {p.indications && (
          <div>
            <h2>Показания</h2>
            <div class="prose" set:html={p.indications} />
          </div>
        )}
        {p.contraindications && (
          <div>
            <h2>Противопоказания</h2>
            <div class="prose" set:html={p.contraindications} />
            <p class="proc-medical__disclaimer">{site.contraindications_text}</p>
          </div>
        )}
      </section>
    )
  }

  {
    priceItems.length > 0 && (
      <section class="section proc-pricing reveal" aria-labelledby="proc-pricing-title">
        <p class="eyebrow">Стоимость</p>
        <h2 id="proc-pricing-title">Цены на «{p.title}»</h2>
        <PriceTable items={priceItems} showPrices={site.show_prices} icd10={p.icd10} contextLabel={p.title} />
      </section>
    )
  }

  {
    cases.length > 0 && (
      <section class="section proc-cases reveal" aria-labelledby="proc-cases-title">
        <p class="eyebrow">Результаты</p>
        <h2 id="proc-cases-title">До и после</h2>
        <div class="proc-cases__grid">
          {cases.map((c) => (
            <CaseCard title={c.title} result={c.result} before={c.before} after={c.after} combined={c.combined} />
          ))}
        </div>
        <a class="text-link" href="/result">
          Все результаты <span>↗</span>
        </a>
      </section>
    )
  }

  <Faq items={faq} title={`Вопросы о процедуре «${p.title}»`} />

  <section class="proc-cta reveal" aria-labelledby="proc-cta-title">
    <h2 id="proc-cta-title">Подберём план для вас</h2>
    <p>Администратор ответит на вопросы и предложит удобное время визита.</p>
    <button class="button" type="button" data-open-sheet data-context={p.title}>
      Записаться <span>↗</span>
    </button>
  </section>
</Page>

<style>
  .proc-hero {
    max-width: var(--container-wide);
    margin: auto;
    display: grid;
    grid-template-columns: 42% 58%;
    gap: 5vw;
    padding: 40px var(--gutter) var(--section);
    align-items: center;
  }
  .proc-hero__image {
    height: 640px;
    background: var(--paper);
  }
  .proc-hero__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .proc-hero h1 {
    font-size: clamp(38px, 5vw, 68px);
    line-height: 0.96;
    margin: 0 0 18px;
  }
  .proc-hero__subtitle {
    color: var(--gold-deep);
    font-size: 15px;
    margin: 0 0 18px;
  }
  .proc-hero__lead {
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.7;
    max-width: 52ch;
    margin: 0 0 32px;
  }
  .proc-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    margin-bottom: 36px;
  }
  .proc-hero__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 18px 24px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    margin: 0;
  }
  .proc-hero__facts dt {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .proc-hero__facts dd {
    margin: 0;
    font: 400 20px var(--display);
    color: var(--gold-deep);
  }

  .proc-steps h2,
  .proc-cases h2,
  .proc-medical h2,
  .proc-pricing h2 {
    font-size: var(--t-h2-s);
    margin: 10px 0 36px;
  }
  .proc-steps__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px;
  }
  .proc-steps__grid article {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 12px;
  }
  .proc-steps__grid span {
    color: var(--gold-deep);
    font-size: 12px;
  }
  .proc-steps__grid h3 {
    font: 400 20px var(--display);
    margin: 0 0 6px;
  }
  .proc-steps__grid p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.55;
    margin: 0;
  }

  .proc-gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }
  .proc-gallery__grid :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .proc-medical {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    background: var(--paper);
    max-width: none;
    padding-left: var(--gutter-wide);
    padding-right: var(--gutter-wide);
  }
  .proc-medical__disclaimer {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .proc-cases__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    margin-bottom: 32px;
  }

  .proc-cta {
    max-width: var(--container);
    margin: auto;
    padding: var(--section) var(--gutter);
    text-align: center;
    background: var(--dark);
    color: var(--dark-text);
  }
  .proc-cta h2 {
    font: 400 clamp(32px, 4vw, 52px) var(--display);
    margin: 0 0 16px;
  }
  .proc-cta p {
    color: #b9b6ac;
    margin: 0 0 32px;
  }

  @media (max-width: 900px) {
    .proc-hero,
    .proc-medical {
      grid-template-columns: 1fr;
    }
    .proc-hero__image {
      height: 420px;
    }
    .proc-medical {
      gap: 40px;
    }
  }
</style>
