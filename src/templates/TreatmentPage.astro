---
import type { CollectionEntry } from 'astro:content';
import Page from '../layouts/Page.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import Faq from '../components/faq/Faq.astro';
import CaseCard from '../components/results/CaseCard.astro';
import ResultsNavigation from '../components/results/ResultsNavigation.astro';
import PriceTable from '../components/pricing/PriceTable.astro';
import { getSiteSettings } from '../lib/siteContent';
import { getCasesForProcedure, getFaqForProcedure, getPriceItemsForProcedure } from '../lib/procedureContent';
import { em, formatPrice } from '../lib/markup';

interface Props { procedure: CollectionEntry<'procedures'>; device?: boolean }
const { procedure, device = false } = Astro.props;
const p = procedure.data;
const [site, allCases, faq, prices] = await Promise.all([
  getSiteSettings(), getCasesForProcedure(p.slug), getFaqForProcedure(p.slug), getPriceItemsForProcedure(p.slug),
]);
// A lone “after” photograph is not a before/after comparison.
const cases = allCases.filter(c => c.combined || (c.before && c.after));
const amounts = prices.flatMap(item => [item.price, item.priceHeadDoctor]).filter((price): price is number => price !== null);
const startingPrice = site.show_prices && amounts.length ? formatPrice(Math.min(...amounts)) : null;
const facts = [
  p.duration && { label: 'Длительность', value: p.duration },
  p.rehab && { label: 'Восстановление', value: p.rehab },
  p.effect_duration && { label: 'Эффект', value: p.effect_duration },
  p.sessions && { label: 'Курс', value: p.sessions },
].filter(Boolean) as Array<{ label: string; value: string }>;
---
<Page title={p.seo_title || `${p.title} — PERI CLINIC`} description={p.seo_description || p.summary || p.lead || ''}>
  <Breadcrumbs slot="head" items={[...(p.category ? [{ name: p.category.title, href: `/${p.category.slug}` }] : []), { name: p.title, href: `/${p.slug}` }]} />
  <section class="treatment-hero" aria-labelledby="treatment-title">
    <div class="treatment-hero__content">
      <p class="eyebrow">PERI CLINIC{p.category && ` · ${p.category.title}`}</p>
      <h1 id="treatment-title" set:html={em(p.title)} />
      {p.subtitle && <p class="treatment-subtitle">{p.subtitle}</p>}
      {(p.lead || p.summary) && <p class="treatment-lead">{p.lead || p.summary}</p>}
      <div class="treatment-actions">
        <button class="button" type="button" data-open-sheet data-context={p.title}>Записаться на консультацию <span>↗</span></button>
        <a class="text-link" href="#prices">{startingPrice ? `От ${startingPrice}` : 'Узнать стоимость'} <span>↓</span></a>
      </div>
      {facts.length > 0 && <dl class="treatment-facts">{facts.map(f => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>}
    </div>
  </section>

  <nav class="treatment-nav" aria-label="Разделы страницы">
    <a href="#about">Описание</a>
    {(device || cases.length > 0) && <a href="#results">До и после</a>}
    {p.steps.length > 0 && <a href="#visit">Этапы процедуры</a>}
    <a href="#prices">Цены</a>
    <a href="#booking">Запись</a>
  </nav>

  <section id="about" class="section treatment-about reveal" aria-labelledby="about-title">
    <div><p class="eyebrow">О методике</p><h2 id="about-title">{device ? 'Об аппарате и процедуре' : 'О процедуре'}</h2></div>
    <div>
      <div class="prose" set:html={p.body || `<p>${em(p.summary || p.lead || p.title)}</p>`} />
      {p.benefits.length > 0 && <div class="treatment-benefits">{p.benefits.map(b => <article><h3>{b.title}</h3><p>{b.text}</p></article>)}</div>}
    </div>
  </section>

  {(device || cases.length > 0) && <section id="results" class="section treatment-results reveal" data-results-carousel data-results-limit={cases.length} aria-labelledby="results-title">
    <p class="eyebrow">Результаты</p><h2 id="results-title">До и после</h2>
    {cases.length > 0 ? <>
      <p class="treatment-note">Примеры результатов процедуры «{p.title}». Результат и количество процедур индивидуальны.</p>
      <div class="treatment-cases" id="treatment-results-rail" data-results-rail role="group" aria-label="Работы до и после">{cases.map(c => <CaseCard mobileHomeStyle preserveAspect preserveDesktopAspect title={c.title} result={c.result} before={c.before} after={c.after} combined={c.combined} />)}</div>
      <ResultsNavigation count={cases.length} railId="treatment-results-rail" />
    </> : <p class="treatment-note">Фотографии до и после по этой процедуре пока не представлены. В общей галерее можно посмотреть результаты других процедур клиники.</p>}
    <a class="text-link" href="/result">Все работы клиники <span>↗</span></a>
  </section>}

  {p.steps.length > 0 && <section id="visit" class="section treatment-visit reveal" aria-labelledby="visit-title">
    <p class="eyebrow">Ваш визит</p><h2 id="visit-title">Как проходит процедура</h2>
    <ol class="treatment-steps">{p.steps.map(s => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}</ol>
  </section>}

  {(p.indications || p.contraindications) && <section class:list={['section treatment-medical reveal', { 'treatment-medical--single': !p.indications || !p.contraindications }]} aria-label="Показания и противопоказания">
    {p.indications && <div><h2>Кому подходит процедура</h2><div class="prose" set:html={p.indications} /></div>}
    {p.contraindications && <div><h2>Противопоказания</h2><div class="prose" set:html={p.contraindications} /></div>}
  </section>}

  <section id="prices" class="section treatment-prices reveal" aria-labelledby="prices-title">
    <div><p class="eyebrow">Стоимость</p><h2 id="prices-title">Цены на процедуру</h2><p class="treatment-note">Выберите нужную зону или вариант процедуры в прайсе.</p></div>
    <div>
      {prices.length > 0 ? <PriceTable mobileCards items={prices} showPrices={site.show_prices} icd10={p.icd10} contextLabel={p.title} /> : <p class="treatment-note">Стоимость можно уточнить у администратора перед записью.</p>}
      <div class="treatment-actions"><button class="button" type="button" data-open-sheet data-context={p.title}>Уточнить стоимость и записаться <span>↗</span></button><a class="text-link" href="/uslugi-i-ceny">Полный прайс <span>↗</span></a></div>
    </div>
  </section>

  <Faq items={faq} title="Вопросы о процедуре" />

  <section id="booking" class="treatment-cta reveal" aria-labelledby="booking-title">
    <p class="eyebrow">Следующий шаг</p>
    <h2 id="booking-title">Начните с консультации</h2>
    <p>Обсудите процедуру «{p.title}» с врачом: подходит ли она для вашей задачи, какого результата можно ожидать и какой план визитов выбрать.</p>
    <p>Администратор ответит на вопросы о записи и поможет выбрать удобное время визита.</p>
    <button class="button" type="button" data-open-sheet data-context={p.title}>Записаться на консультацию <span>↗</span></button>
    {site.contraindications_text && <p class="treatment-cta__disclaimer">{site.contraindications_text}</p>}
  </section>
</Page>

<script>
  import { initResultsCarousel } from '../scripts/results-carousel';
  // Module scripts run once under ClientRouter; the init is idempotent (data-results-ready).
  document.addEventListener('astro:page-load', initResultsCarousel);
</script>

<style>

  .treatment-hero { max-width: var(--container-wide); margin: auto; padding: 48px var(--gutter) 64px; display: grid; grid-template-columns: 1fr; gap: 5vw; align-items: center; }
  .treatment-hero__content, .treatment-about > div, .treatment-prices > div, .treatment-medical > div { min-width: 0; }
  h1 { font-size: clamp(36px, 4.5vw, 66px); line-height: 1.06; margin: 18px 0 24px; overflow-wrap: anywhere; }
  h2 { font-size: var(--t-h2-s); line-height: 1.1; margin: 12px 0 28px; }
  h3 { font: 400 26px var(--display); margin: 0 0 12px; }
  .treatment-subtitle { color: var(--gold-deep); }
  .treatment-lead { color: var(--ink-2); line-height: 1.75; max-width: 58ch; }
  .treatment-actions { display: flex; flex-wrap: wrap; gap: 22px; align-items: center; margin-top: 30px; }
  .treatment-actions .button, .treatment-cta .button { white-space: normal; text-align: left; }
  .treatment-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; border-top: 1px solid var(--line); padding-top: 24px; margin-top: 32px; }
  dt { color: var(--muted); font-size: 12px; } dd { margin: 6px 0 0; font: 400 23px var(--display); }
  .treatment-nav { display: flex; flex-wrap: wrap; gap: 10px 28px; max-width: var(--container); margin: auto; padding: 22px var(--gutter); border-block: 1px solid var(--line); }
  .treatment-nav a { padding: 8px 0; font-size: 13px; border-bottom: 1px solid transparent; }
  .treatment-nav a:hover { border-color: var(--gold-deep); }
  section[id] { scroll-margin-top: 110px; }
  .treatment-about, .treatment-prices { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 6vw; }
  .treatment-about .prose { max-width: 70ch; }
  .treatment-visit, .treatment-results { background: var(--paper); }
  .treatment-steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; list-style: none; counter-reset: step; padding: 0; }
  .treatment-steps li { counter-increment: step; border-top: 1px solid var(--line); padding-top: 20px; }
  .treatment-steps li::before { content: counter(step, decimal-leading-zero); display: block; color: var(--gold-deep); margin-bottom: 18px; font-size: 13px; }
  .treatment-steps p, .treatment-benefits p, .treatment-note { color: var(--muted); font-size: 14px; line-height: 1.75; }
  .treatment-medical { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; }
  .treatment-cases { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; margin: 30px 0; }
  .treatment-prices :global(.price-table) { max-width: none; overflow-x: auto; }
  .treatment-cta { max-width: var(--container); margin: 0 auto; padding: var(--section) var(--gutter); background: var(--dark); color: var(--dark-text); text-align: center; }
  .treatment-cta h2 { font-size: clamp(36px, 4vw, 56px); }
  .treatment-cta p:not(.eyebrow) { max-width: 64ch; margin: 0 auto 24px; color: #b9b6ac; line-height: 1.75; }
  .treatment-cta .eyebrow { color: var(--gold); }
  .treatment-cta .treatment-cta__disclaimer { margin-top: 26px; margin-bottom: 0; font-size: 12px; }
  .treatment-benefits { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 32px; }
  .treatment-benefits article { padding-top: 20px; border-top: 1px solid var(--line); }
  .treatment-medical--single { grid-template-columns: 1fr; }
  .treatment-medical .prose { max-width: 70ch; }
  .treatment-about :global(.prose), .treatment-medical :global(.prose), .treatment-facts dd { overflow-wrap: anywhere; }
  .treatment-nav a { min-height: 44px; display: inline-flex; align-items: center; }
  @media (max-width: 900px) {
    .treatment-hero, .treatment-about, .treatment-prices { grid-template-columns: 1fr; gap: 30px; }
  }
  @media (max-width: 600px) {
    .treatment-hero { padding-top: 28px; padding-bottom: 40px; }
    .section { padding-block: 56px; }
    h2 { font-size: clamp(32px, 8vw, 42px); overflow-wrap: anywhere; }
    .treatment-actions { gap: 18px; }
    .treatment-actions .button, .treatment-cta .button { width: 100%; justify-content: space-between; min-height: 52px; }
    .treatment-facts { gap: 20px 16px; }
    .treatment-facts dd { font-size: 21px; }
    .treatment-benefits { grid-template-columns: 1fr; }
    .treatment-medical { gap: 28px; }
    .treatment-cta { padding-block: 56px; }
    .treatment-steps, .treatment-medical, .treatment-cases { grid-template-columns: 1fr; }
    .treatment-nav { gap: 4px 20px; }
  }
  @media (max-width: 800px) {
    .treatment-results { --results-card-width: min(70vw, 280px, 32svh); }
    .treatment-cases {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
      scroll-behavior: smooth;
      gap: 14px;
      margin-right: calc(-1 * var(--gutter));
      padding-right: calc(100vw - var(--gutter) - var(--results-card-width));
      padding-bottom: 24px;
      margin-bottom: -24px;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
    }
    .treatment-cases::-webkit-scrollbar { display: none; }
    .treatment-cases:focus-visible { outline: 2px solid var(--gold-deep); outline-offset: 4px; }
    .treatment-results > .text-link { display: inline-flex; margin-top: 18px; }
  }

  @media (max-width: 800px) and (prefers-reduced-motion: reduce) {
    .treatment-cases { scroll-behavior: auto; }
  }
</style>
