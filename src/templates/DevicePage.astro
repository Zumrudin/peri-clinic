---
import type { CollectionEntry } from 'astro:content';
import TreatmentPage from './TreatmentPage.astro';
import ApprovedTreatmentPage from './ApprovedTreatmentPage.astro';

interface Props { procedure: CollectionEntry<'procedures'> }
const { procedure } = Astro.props;
---
{procedure.data.approved_layout ? <ApprovedTreatmentPage procedure={procedure} /> : <TreatmentPage procedure={procedure} device />}
