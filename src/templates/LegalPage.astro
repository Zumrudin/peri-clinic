---
import Page from '../layouts/Page.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { getAllPages } from '../lib/pageContent';
import type { CollectionEntry } from 'astro:content';
import { load } from 'cheerio';

interface Props { page: CollectionEntry<'pages'> }
const { page } = Astro.props;
const p = page.data;
const hubSlug = 'yuridicheskaya-informaciya';
const isHub = p.slug === hubSlug;
const allPages = await getAllPages();
const documents = allPages.filter(({ data }) => data.template === 'legal' && data.slug !== hubSlug);
const hub = allPages.find(({ data }) => data.slug === hubSlug);
const hubTitle = hub?.data.title || 'Юридическая информация';
const $ = load(p.body || '', null, false);
const sections: Array<{ id: string; title: string }> = [];
$('h2').each((i, el) => {
  const id = `document-section-${i + 1}`;
  $(el).attr('id', id);
  sections.push({ id, title: $(el).text() });
});
const body = $.html();
---

<Page title={p.seo_title || `${p.title} — PERI CLINIC`} description={p.seo_description || p.lead || ''} noindex={p.noindex}>
  <div class="legal-page">
    <Breadcrumbs items={[
      ...(!isHub ? [{ name: hubTitle, href: `/${hubSlug}` }] : []),
      { name: p.title, href: `/${p.slug}` },
    ]} />
    <header class="legal-heading">
      <p class="legal-eyebrow">PERI CLINIC · Информация для пациентов</p>
      <h1>{p.title}</h1>
      {p.lead && <p class="legal-lead">{p.lead}</p>}
    </header>
    {isHub ? (
      <>
        {body && <div class="legal-prose prose" set:html={body} />}
        <div class="legal-cards">
          {documents.map(({ data: doc }, i) => (
            <a class="legal-card" href={`/${doc.slug}`}>
              <span class="legal-card__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div><h2>{doc.title}</h2>{doc.lead && <p>{doc.lead}</p>}</div>
              <span class="legal-card__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </>
    ) : (
      <div class="legal-layout">
        <aside class="legal-sidebar">
          <nav aria-label="Юридические документы">
            <p class="legal-sidebar__label">Документы раздела</p>
            {documents.map(({ data: doc }) => <a href={`/${doc.slug}`} aria-current={p.slug === doc.slug ? 'page' : undefined}>{doc.title}</a>)}
          </nav>
        </aside>
        <article class="legal-document" aria-label={p.title}>
          {sections.length > 1 && <details class="legal-toc" open>
            <summary>Содержание документа</summary>
            <nav aria-label="Содержание документа"><ol>{sections.map(section => <li><a href={`#${section.id}`}>{section.title}</a></li>)}</ol></nav>
          </details>}
          <div class="legal-prose prose" set:html={body} />
          <a class="legal-back" href={`/${hubSlug}`}>← Все юридические документы</a>
        </article>
      </div>
    )}
  </div>
</Page>

<style>
  .legal-page { max-width: 1440px; margin: auto; padding: 34px var(--gutter) var(--section); }
  .legal-page :global(.breadcrumbs) { padding: 0; }
  .legal-heading { padding: 54px 0 46px; max-width: 930px; }
  .legal-eyebrow { color: var(--gold-deep); font-size: 0.6875rem; letter-spacing: .13em; text-transform: uppercase; margin: 0 0 22px; }
  h1 { font: 400 clamp(38px, 4.6vw, 68px)/1.06 var(--display); margin: 0 0 24px; text-wrap: balance; overflow-wrap: anywhere; }
  .legal-lead { max-width: 700px; font-size: 1rem; line-height: 1.75; color: var(--ink-2); margin: 0; }
  .legal-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .legal-card { display: grid; grid-template-columns: 30px 1fr 24px; gap: 18px; padding: 32px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); transition: border-color .2s, background .2s; }
  .legal-card:hover { border-color: var(--gold); background: var(--white); }
  .legal-card__number { font-size: 0.75rem; color: var(--gold-deep); padding-top: 7px; }
  .legal-card__arrow { font-size: 1.5rem; color: var(--gold-deep); }
  .legal-card h2 { font: 400 clamp(25px, 2.3vw, 34px)/1.12 var(--display); margin: 0 0 16px; }
  .legal-card p { font-size: 0.8125rem; line-height: 1.75; color: var(--ink-2); margin: 0; }
  .legal-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 40px; align-items: start; }
  .legal-sidebar { position: sticky; top: calc(var(--header-h) + 24px); }
  .legal-sidebar__label { margin: 0 0 16px; color: var(--gold-deep); font-size: 0.6875rem; letter-spacing: .08em; text-transform: uppercase; }
  .legal-sidebar a { display: block; padding: 12px 14px; border-left: 2px solid var(--line); font-size: 0.75rem; line-height: 1.55; color: var(--ink-2); }
  .legal-sidebar a:hover, .legal-sidebar a[aria-current] { background: var(--sand); border-color: var(--gold-deep); color: var(--ink); }
  .legal-document { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(22px, 3.2vw, 48px); min-width: 0; }
  .legal-toc { margin: 0 0 36px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  .legal-toc summary { cursor: pointer; font-size: 0.875rem; font-weight: 500; }
  .legal-toc ol { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 12px; }
  .legal-toc a { font-size: 0.8125rem; line-height: 1.6; color: var(--gold-deep); text-decoration: underline; text-underline-offset: 4px; }
  .legal-prose { font-size: 0.9375rem; line-height: 1.85; color: var(--ink-2); overflow-wrap: anywhere; }
  .legal-prose :global(h2) { font: 400 clamp(27px, 2.7vw, 36px)/1.18 var(--display); color: var(--ink); margin: 42px 0 22px; scroll-margin-top: calc(var(--header-h) + 24px); }
  .legal-prose :global(h2:first-child) { margin-top: 0; }
  .legal-prose :global(p) { margin-bottom: 20px; }
  .legal-prose :global(.legal-details) { display: grid; grid-template-columns: minmax(130px, .7fr) 1.5fr; margin: 0; }
  .legal-prose :global(dt), .legal-prose :global(dd) { margin: 0; padding: 15px 0; border-bottom: 1px solid var(--line); }
  .legal-prose :global(dt) { font-size: 0.75rem; padding-right: 22px; color: var(--muted); }
  .legal-prose :global(dd) { font-size: 0.875rem; color: var(--ink); }
  .legal-prose :global(.legal-register) { list-style: none; padding: 0; margin: 0; }
  .legal-prose :global(.legal-register li) { margin: 0; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .legal-prose :global(.legal-register li:first-child) { padding-top: 0; }
  .legal-prose :global(.legal-register li:last-child) { border-bottom: 0; }
  .legal-prose :global(.legal-download) { display: inline-block; padding: 15px 22px; border: 1px solid var(--gold-deep); border-radius: 12px; }
  .legal-back { display: inline-block; margin-top: 32px; color: var(--gold-deep); font-size: 0.8125rem; }
  @media (max-width: 1000px) { .legal-layout { grid-template-columns: 190px minmax(0, 1fr); gap: 24px; } .legal-card { padding: 24px; gap: 12px; } }
  @media (max-width: 800px) {
    .legal-heading { padding: 36px 0 32px; }
    .legal-layout, .legal-cards { grid-template-columns: 1fr; }
    .legal-sidebar { position: static; order: 2; }
    .legal-card { grid-template-columns: 24px 1fr 20px; }
    .legal-prose :global(.legal-details) { grid-template-columns: 1fr; }
    .legal-prose :global(dt) { border: 0; padding: 16px 0 2px; }
    .legal-prose :global(dd) { padding: 0 0 16px; }
  }
  @media print {
    .legal-sidebar, .legal-page :global(.breadcrumbs), .legal-toc, .legal-back { display: none; }
    .legal-layout { display: block; }
    .legal-document { padding: 0; border: 0; }
  }
</style>
