---
import { getSiteSettings } from '../../lib/siteContent';
import { telHref } from '../../lib/markup';

const site = await getSiteSettings();
---

<div class="mobile-cta-bar">
  <a class="mobile-cta-bar__call" href={telHref(site.phone)} data-goal="contact_call">
    <span aria-hidden="true">↗</span> Позвонить
  </a>
  <button class="button mobile-cta-bar__book" type="button" data-open-sheet>Записаться</button>
</div>

<style>
  .mobile-cta-bar {
    display: none;
  }
  @media (max-width: 800px) {
    .mobile-cta-bar {
      display: flex;
      position: fixed;
      z-index: var(--z-menu);
      inset: auto 0 0;
      padding: 10px 20px calc(10px + env(safe-area-inset-bottom));
      gap: 10px;
      /* Floating chrome: translucent material with content scrolling under it, and a soft
         scroll edge above instead of a hairline. */
      background: rgba(246, 244, 239, 0.85);
      backdrop-filter: blur(var(--blur));
      -webkit-backdrop-filter: blur(var(--blur));
    }
    .mobile-cta-bar::before {
      content: '';
      position: absolute;
      inset: auto 0 100%;
      height: 20px;
      background: linear-gradient(to top, rgba(246, 244, 239, 0.85), rgba(246, 244, 239, 0));
      pointer-events: none;
    }
    @media (prefers-reduced-transparency: reduce) {
      .mobile-cta-bar {
        background: var(--ivory);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        box-shadow: 0 -8px 24px rgba(30, 29, 25, 0.06);
      }
      .mobile-cta-bar::before {
        display: none;
      }
    }
    .mobile-cta-bar__call {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 0 12px;
      min-height: 48px;
      font-size: 14px;
      border: 1px solid var(--line);
      border-radius: 16px;
      color: var(--gold-deep);
      transition: transform var(--dur-press) var(--ease-out);
    }
    .mobile-cta-bar__call:active {
      transform: scale(0.97);
    }
    .mobile-cta-bar__book {
      flex: 1 1 auto;
      min-height: 48px;
      border-radius: 16px;
      font-size: 14px;
      letter-spacing: 0;
      text-transform: none;
      min-width: 0;
      padding-inline: 16px;
      justify-content: center;
    }
  }
</style>
