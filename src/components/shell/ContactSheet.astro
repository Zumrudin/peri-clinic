---
import site from '../../data/site.json';
import { telHref, whatsappHref } from '../../lib/markup';

const rows = [
  { goal: 'contact_call', label: 'Позвонить', hint: site.phone, href: telHref(site.phone), icon: 'phone', attrs: {} },
  site.telegram_url && {
    goal: 'contact_tg',
    label: 'Telegram',
    hint: 'ответим в течение часа',
    href: site.telegram_url,
    icon: 'tg',
    attrs: { target: '_blank', rel: 'noopener' },
  },
  {
    goal: 'contact_wa',
    label: 'WhatsApp',
    hint: 'написать в чат',
    href: whatsappHref(site.phone, site.whatsapp_text),
    icon: 'wa',
    attrs: {
      target: '_blank',
      rel: 'noopener',
      'data-whatsapp': true,
      'data-base': whatsappHref(site.phone),
      'data-text': site.whatsapp_text,
    },
  },
  site.max_url && {
    goal: 'contact_max',
    label: 'MAX',
    hint: 'мессенджер',
    href: site.max_url,
    icon: 'max',
    attrs: { target: '_blank', rel: 'noopener' },
  },
].filter(Boolean) as Array<{
  goal: string;
  label: string;
  hint: string;
  href: string;
  icon: string;
  attrs: Record<string, unknown>;
}>;
---

<dialog class="sheet" id="contact-sheet" aria-labelledby="contact-sheet-title">
  <div class="sheet__panel">
    <div class="sheet__handle" aria-hidden="true"></div>
    <button class="sheet__close" type="button" aria-label="Закрыть" data-close-sheet>×</button>
    <p class="eyebrow">Запись на приём</p>
    <h2 class="sheet__title" id="contact-sheet-title">Как вам удобнее<br><em>связаться?</em></h2>
    <p class="sheet__lead">{site.hours}. Администратор уточнит запрос и подберёт время визита.</p>
    <ul class="sheet__list">
      {
        rows.map((row) => (
          <li>
            <a class="sheet__row" href={row.href} data-goal={row.goal} {...row.attrs}>
              <span class={`sheet__icon sheet__icon--${row.icon}`} aria-hidden="true">
                {row.icon === 'phone' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
                  </svg>
                )}
                {row.icon === 'tg' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                    <path d="M21.5 3.5 2.9 10.7c-1 .4-1 1 0 1.3l4.7 1.5 1.8 5.6c.2.6.4.8.9.8.5 0 .7-.2 1-.5l2.5-2.4 4.8 3.6c.9.5 1.5.2 1.7-.8l3.2-15c.3-1.3-.5-1.9-1.5-1.3ZM8.5 13.2l9.4-5.9c.5-.3.9-.1.5.2l-7.7 7-.3 3.3-1.9-4.6Z" />
                  </svg>
                )}
                {row.icon === 'wa' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.6 1.1 2.8.1.2 1.9 2.9 4.6 4 1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.4-.2Z" />
                  </svg>
                )}
                {row.icon === 'max' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="M4 19V5l8 9 8-9v14" />
                  </svg>
                )}
              </span>
              <span class="sheet__text">
                <strong>{row.label}</strong>
                <small>{row.hint}</small>
              </span>
              <span class="sheet__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="sheet__note">{site.contraindications_text}</p>
  </div>
</dialog>

<style>
  .sheet {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    color: var(--ink);
  }
  .sheet::backdrop {
    background: rgba(36, 36, 31, 0.55);
    backdrop-filter: blur(4px);
  }
  .sheet[open] {
    display: grid;
    place-items: center;
  }
  .sheet__panel {
    position: relative;
    width: min(440px, calc(100% - 32px));
    background: var(--paper);
    padding: 40px 36px 30px;
    border-radius: var(--radius);
    box-shadow: 0 30px 80px rgba(20, 18, 12, 0.25);
    animation: sheetIn 0.3s var(--ease-out) both;
  }
  .sheet__handle {
    display: none;
  }
  .sheet__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    font-size: 26px;
    line-height: 1;
    color: var(--muted);
  }
  .sheet__close:hover {
    color: var(--ink);
  }
  .sheet .eyebrow {
    margin-bottom: 14px;
  }
  .sheet__title {
    font-size: 36px;
    line-height: 1;
    margin-bottom: 14px;
  }
  .sheet__lead {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 22px;
  }
  .sheet__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .sheet__row {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 64px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-fast);
  }
  .sheet__row:hover {
    color: var(--gold-deep);
  }
  .sheet__icon {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--gold);
  }
  .sheet__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sheet__text strong {
    font-size: 15px;
    font-weight: 600;
  }
  .sheet__text small {
    font-size: 12px;
    color: var(--muted);
  }
  .sheet__arrow {
    margin-left: auto;
    color: var(--gold);
    font-size: 18px;
  }
  .sheet__note {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }
  @keyframes sheetIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 800px) {
    .sheet[open] {
      place-items: end center;
    }
    .sheet__panel {
      width: 100%;
      border-radius: 14px 14px 0 0;
      padding: 14px 20px calc(24px + env(safe-area-inset-bottom));
      animation-name: sheetUp;
    }
    .sheet__handle {
      display: block;
      width: 40px;
      height: 4px;
      border-radius: 2px;
      background: var(--line);
      margin: 0 auto 20px;
    }
    .sheet__title {
      font-size: 32px;
    }
    @keyframes sheetUp {
      from {
        transform: translateY(100%);
      }
      to {
        transform: none;
      }
    }
  }
</style>
