---
import { getSiteSettings } from '../../lib/siteContent';
import { getCookieConsent } from '../../lib/cookieContent';
const site = await getSiteSettings();
const copy = site.cookie_notice;
const consent = await getCookieConsent();
---
<aside class="cookie-notice" data-cookie-notice hidden aria-labelledby="cookie-title" tabindex="-1"
  data-counter={site.metrika_id} data-version={consent.version} data-sha256={consent.sha256}
  data-enabled={copy.enabled} data-disabled={copy.disabled} data-storage-error={copy.storage_error}
  transition:persist="cookie-notice">
  <h2 id="cookie-title">{copy.title}</h2>
  <p>{site.metrika_id ? copy.description : copy.inactive}</p>
  <p class="cookie-notice__links"><a href={consent.url}>{copy.consent}</a><a href={site.privacy_url}>{copy.policy}</a></p>
  <p data-cookie-status role="status" aria-live="polite"></p>
  <div class="cookie-notice__actions">
    <button type="button" data-cookie-accept disabled={!site.metrika_id}>{copy.accept}</button>
    <button type="button" data-cookie-reject>{copy.reject}</button>
    <button type="button" data-cookie-revoke hidden>{copy.revoke}</button>
    <button type="button" data-cookie-close>{copy.close}</button>
  </div>
</aside>
<style>
  .cookie-notice { position: fixed; z-index: var(--z-menu); left: 16px; right: 16px; bottom: 16px; max-width: 660px; margin: auto; padding: 20px; background: var(--dark); color: var(--dark-text); border-radius: var(--radius); box-shadow: 0 20px 50px #14120c4d; max-height: 70dvh; overflow: auto; }
  .cookie-notice[hidden], .cookie-notice [hidden] { display: none; }
  .cookie-notice h2 { font: 500 1.125rem/1.3 var(--sans); margin: 0 0 10px; color: #fff; }
  .cookie-notice p { font-size: .8125rem; line-height: 1.5; margin: 8px 0; color: #e0ddd4; }
  .cookie-notice a { color: var(--gold-light); text-decoration: underline; }
  .cookie-notice__links, .cookie-notice__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cookie-notice__actions { margin-top: 14px; }
  .cookie-notice button { flex: 1 1 auto; border: 1px solid #cfccc0; border-radius: 12px; background: transparent; color: #fff; padding: 12px; font: 500 .8125rem/1.3 var(--sans); cursor: pointer; min-height: 44px; }
  .cookie-notice button:disabled { opacity: .55; cursor: default; }
  .cookie-notice :focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  @media (max-width: 800px) { .cookie-notice { left: 12px; right: 12px; bottom: calc(80px + env(safe-area-inset-bottom)); padding: 16px; } }
</style>
