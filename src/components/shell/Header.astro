---
import { Image } from 'astro:assets';
import { getSiteSettings } from '../../lib/siteContent';
import { telHref } from '../../lib/markup';
import logo from '../../assets/home/logo.png';

const site = await getSiteSettings();
---

<header class="header" data-header>
  <a class="logo" href="/" aria-label={`${site.name} — на главную`}>
    <Image src={logo} alt={site.name} width={184} densities={[1, 2]} loading="eager" />
  </a>

  <nav class="nav" id="main-nav" aria-label="Основная навигация">
    {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <div class="nav__mobile-extra">
      <a class="nav__phone" href={telHref(site.phone)}>{site.phone}</a>
      <button class="button" type="button" data-open-sheet>Записаться <span>↗</span></button>
    </div>
  </nav>

  <a class="header-phone" href={telHref(site.phone)}>{site.phone}</a>
  <button class="button button--small header-book" type="button" data-open-sheet>Записаться <span>↗</span></button>
  <button
    class="menu-toggle"
    type="button"
    aria-label="Открыть меню"
    aria-expanded="false"
    aria-controls="main-nav"
    data-menu-toggle
  >
    <span></span><span></span>
  </button>
</header>

<script>
  import { initStickyHeader } from '../../scripts/header';
  import { initMobileMenu } from '../../scripts/menu';
  initStickyHeader(document.querySelector('[data-header]'));
  initMobileMenu(document.querySelector('[data-menu-toggle]'), document.getElementById('main-nav'));
</script>

<style>
  .header {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 38px;
    padding: 0 4.1vw;
    border-bottom: 1px solid var(--line);
    background: rgba(246, 244, 239, 0.82);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    position: relative;
    z-index: var(--z-header);
    transition:
      height 0.3s,
      box-shadow 0.3s;
  }
  .header.is-sticky {
    height: var(--header-h-sticky);
    position: fixed;
    inset: 0 0 auto;
    box-shadow: 0 8px 30px rgba(170, 137, 47, 0.08);
    animation: headerIn 0.35s both;
  }
  :global(.header.is-sticky + main) {
    padding-top: var(--header-h);
  }
  @keyframes headerIn {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: none;
    }
  }
  .logo {
    flex: 0 0 auto;
    width: 184px;
  }
  .logo img {
    width: 184px;
    height: auto;
  }
  .nav {
    display: flex;
    gap: 29px;
    margin-left: auto;
  }
  .nav > a {
    position: relative;
    padding: 8px 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.035em;
  }
  .nav > a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 2px;
    height: 1px;
    background: var(--gold);
    transition: right var(--dur-fast);
  }
  .nav > a:hover::after {
    right: 0;
  }
  .nav__mobile-extra {
    display: none;
  }
  .header-phone {
    font-family: var(--display);
    font-size: 17px;
    white-space: nowrap;
  }
  .menu-toggle {
    display: none;
  }

  @media (max-width: 1100px) {
    .nav {
      gap: 17px;
    }
    .header-phone {
      display: none;
    }
  }

  @media (max-width: 800px) {
    .header {
      padding: 0 18px;
      gap: 0;
    }
    .logo,
    .logo img {
      width: 150px;
    }
    .header-book {
      display: none;
    }
    .menu-toggle {
      display: block;
      margin-left: auto;
      width: 44px;
      height: 44px;
      border: 0;
      background: transparent;
      padding: 12px;
      position: relative;
    }
    .menu-toggle span {
      position: absolute;
      left: 11px;
      right: 11px;
      height: 1px;
      background: var(--ink);
      transition: var(--dur-fast);
    }
    .menu-toggle span:first-child {
      top: 18px;
    }
    .menu-toggle span:last-child {
      top: 25px;
    }
    .menu-toggle[aria-expanded='true'] span:first-child {
      top: 22px;
      transform: rotate(45deg);
    }
    .menu-toggle[aria-expanded='true'] span:last-child {
      top: 22px;
      transform: rotate(-45deg);
    }
    .nav {
      position: fixed;
      z-index: var(--z-menu);
      inset: var(--header-h) 0 auto;
      height: calc(100dvh - var(--header-h));
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 35px 24px;
      background: var(--ivory);
      transform: translateX(100%);
      visibility: hidden;
      opacity: 0;
      overflow-y: auto;
      transition:
        transform 0.35s,
        opacity 0.35s,
        visibility 0.35s;
    }
    .nav.is-open {
      transform: none;
      visibility: visible;
      opacity: 1;
    }
    .nav > a {
      font: 400 33px/1.2 var(--display);
      letter-spacing: 0;
      padding: 15px 0;
      border-bottom: 1px solid var(--line);
    }
    .nav > a::after {
      display: none;
    }
    .header.is-sticky .nav {
      inset: var(--header-h-sticky) 0 auto;
      height: calc(100dvh - var(--header-h-sticky));
    }
    .nav__mobile-extra {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-top: auto;
      padding-top: 30px;
    }
    .nav__phone {
      font: 400 26px var(--display);
    }
    .nav__mobile-extra .button {
      width: 100%;
    }
  }
</style>
