---
import { Image } from 'astro:assets';
import { getSiteSettings } from '../../lib/siteContent';
import { telHref } from '../../lib/markup';
import logo from '../../assets/home/logo.png';

const site = await getSiteSettings();
---

<header class="header" data-header transition:persist="header">
  <a class="logo" href="/" aria-label={`${site.name} — на главную`}>
    <Image src={logo} alt={site.name} width={184} densities={[1, 2, 3]} quality={100} loading="eager" />
  </a>

  <nav class="nav" id="main-nav" aria-label="Основная навигация">
    {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    {site.shop_url && <a class="nav__shop" href={site.shop_url} target="_blank" rel="noopener">Интернет магазин профессиональной косметики</a>}
    <div class="nav__mobile-extra">
      <a class="nav__phone" href={telHref(site.phone)}>{site.phone}</a>
      <button class="button" type="button" data-open-sheet>Записаться <span>↗</span></button>
    </div>
  </nav>

  <a class="header-phone" href={telHref(site.phone)}>{site.phone}</a>
  <button class="button button--small header-book" type="button" data-open-sheet>Записаться <span>↗</span></button>
  <button
    class="menu-toggle"
    type="button"
    aria-label="Открыть меню"
    aria-expanded="false"
    aria-controls="main-nav"
    data-menu-toggle
  >
    <span></span><span></span>
  </button>
</header>

<script>
  import { initStickyHeader } from '../../scripts/header';
  import { initMobileMenu } from '../../scripts/menu';
  initStickyHeader(document.querySelector('[data-header]'));
  initMobileMenu(document.querySelector('[data-menu-toggle]'), document.getElementById('main-nav'));
</script>

<style>
  .header {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 4.1vw;
    border-bottom: 1px solid var(--line);
    background: rgba(246, 244, 239, 0.82);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    position: relative;
    z-index: var(--z-header);
    transition: box-shadow var(--dur-fast) var(--ease-out);
  }
  .header.is-sticky {
    height: var(--header-h-sticky);
    position: fixed;
    inset: 0 0 auto;
    /* Floating chrome separates from content with a soft shadow, not a hairline. */
    border-bottom-color: transparent;
    box-shadow: 0 8px 30px rgba(170, 137, 47, 0.08);
    animation: headerIn 0.3s var(--ease-out) both;
  }
  /* Exit mirrors the entry (header.ts adds `is-leaving`, drops both classes on animationend). */
  .header.is-sticky.is-leaving {
    animation: headerOut 0.25s var(--ease-out) both;
  }
  @keyframes headerOut {
    to {
      transform: translateY(-100%);
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .header {
      background: var(--ivory);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  :global(.header.is-sticky + main) {
    padding-top: var(--header-h);
  }
  /* Astro may emit a script between the header and main. Preserve the header's
     flow space on desktop so anchor navigation does not slide under it. */
  @media (min-width:1101px) {
    :global(.header.is-sticky ~ main) { padding-top:var(--header-h); }
  }
  @keyframes headerIn {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: none;
    }
  }
  .logo {
    flex: 0 0 auto;
    width: 184px;
  }
  .logo img {
    width: 184px;
    height: auto;
  }
  .nav {
    display: flex;
    gap: 20px;
    margin-left: auto;
    align-items: center;
  }
  .nav > a {
    position: relative;
    padding: 8px 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.035em;
    white-space: nowrap;
  }
  .nav > .nav__shop {
    max-width: 190px;
    white-space: normal;
  }
  /* Underline grows on the compositor (scaleX), not by animating a layout property. */
  .nav > a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav > a:hover::after {
    transform: scaleX(1);
  }
  .nav__mobile-extra {
    display: none;
  }
  .header-phone {
    font-family: var(--display);
    font-size: 1.0625rem;
    white-space: nowrap;
  }
  .menu-toggle {
    display: none;
  }

  @media (max-width: 1400px) {
    .nav {
      gap: 17px;
    }
    .header-phone {
      display: none;
    }
  }

  @media (max-width: 1100px) {
    .header {
      padding: 0 18px;
      gap: 0;
    }
    .logo,
    .logo img {
      width: 150px;
    }
    .header-book {
      display: none;
    }
    .menu-toggle {
      display: block;
      margin-left: auto;
      width: 44px;
      height: 44px;
      border: 0;
      background: transparent;
      padding: 12px;
      position: relative;
    }
    .menu-toggle span {
      position: absolute;
      left: 11px;
      right: 11px;
      height: 1px;
      background: var(--ink);
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .menu-toggle span:first-child {
      top: 18px;
    }
    .menu-toggle span:last-child {
      top: 25px;
    }
    /* lines keep their `top`; transform brings them to the 22px centre so only the compositor moves */
    .menu-toggle[aria-expanded='true'] span:first-child {
      transform: translateY(4px) rotate(45deg);
    }
    .menu-toggle[aria-expanded='true'] span:last-child {
      transform: translateY(-3px) rotate(-45deg);
    }
    .nav {
      position: fixed;
      z-index: var(--z-menu);
      inset: var(--header-h) 0 auto;
      height: calc(100dvh - var(--header-h));
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 35px 24px;
      background: var(--ivory);
      transform: translateX(100%);
      visibility: hidden;
      opacity: 0;
      overflow-y: auto;
      /* closed state = exit (faster); the open state below carries the slower entry */
      transition:
        transform var(--dur-fast) var(--ease-out),
        opacity var(--dur-fast) var(--ease-out),
        visibility 0s linear var(--dur-fast);
    }
    .nav.is-open {
      transform: none;
      visibility: visible;
      opacity: 1;
      transition:
        transform 0.35s var(--ease-out),
        opacity 0.35s var(--ease-out),
        visibility 0s;
    }
    .nav > a {
      font: 400 2.0625rem/1.2 var(--display);
      letter-spacing: 0;
      padding: 15px 0;
      border-bottom: 1px solid var(--line);
    }
    .nav > a::after {
      display: none;
    }
    .nav > .nav__shop {
      max-width: none;
    }
    .header.is-sticky .nav {
      inset: var(--header-h-sticky) 0 auto;
      height: calc(100dvh - var(--header-h-sticky));
    }
    .nav__mobile-extra {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-top: auto;
      padding-top: 30px;
    }
    .nav__phone {
      font: 400 1.625rem var(--display);
    }
    .nav__mobile-extra .button {
      width: 100%;
    }
  }
</style>
