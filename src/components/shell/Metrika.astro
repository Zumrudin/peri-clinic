---
import { getSiteSettings } from '../../lib/siteContent';

const site = await getSiteSettings();
const metrikaId = site.metrika_id;
const requiresConsent = site.metrika_requires_consent;
---

{
  metrikaId && (
    <script define:vars={{ metrikaId, requiresConsent }}>
      function loadMetrika() {
        if (window.ym) return;
        (function (m, e, t, r, i, k, a) {
          m[i] =
            m[i] ||
            function () {
              (m[i].a = m[i].a || []).push(arguments);
            };
          m[i].l = 1 * new Date();
          (k = e.createElement(t)), (a = e.getElementsByTagName(t)[0]);
          k.async = 1;
          k.src = r;
          a.parentNode.insertBefore(k, a);
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
        window.ym(metrikaId, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true });
      }

      if (!requiresConsent || localStorage.getItem('peri_consent') === '1') {
        loadMetrika();
      } else {
        document.addEventListener('peri:consent', loadMetrika, { once: true });
      }

      document.addEventListener('peri:contact', (e) => {
        if (window.ym) window.ym(metrikaId, 'reachGoal', e.detail.goal);
      });
    </script>
  )
}
