---
import { formatPrice } from '../../lib/markup';
import type { PriceItem } from '../../lib/procedureContent';

interface Props {
  items: PriceItem[];
  mobileCards?: boolean;
  showPrices: boolean;
  contextLabel: string;
  icd10?: string | null;
}
const { items, showPrices, contextLabel, icd10, mobileCards = false } = Astro.props;

/** True when at least one row has a distinct "Гл. врач" price — adds a second amount column and a header row for it. Most procedures have a single price, so the plain single-column layout (no <thead>) stays unchanged for them. */
const hasTiered = items.some((item) => item.priceHeadDoctor !== null);
---

{
  items.length > 0 && (
    <div class:list={['price-table', { 'price-table--cards': mobileCards }]}>
      {icd10 && <p class="price-table__icd">МКБ-10: {icd10}</p>}
      <table aria-label={`Стоимость: ${contextLabel}`}>
        {
          hasTiered && (
            <thead>
              <tr>
                <td></td>
                <th class="price-table__col-label">Врач</th>
                <th class="price-table__col-label">Гл. врач</th>
              </tr>
            </thead>
          )
        }
        <tbody>
          {items.map((item) => {
            const noPriceAtAll = item.price === null && item.priceHeadDoctor === null;
            return (
              <tr>
                <td>
                  {item.name}
                  {item.unit && <span class="price-table__unit"> · {item.unit}</span>}
                  {item.medicalServiceCode && (
                    <span class="price-table__service-code" title={item.medicalServiceName ?? undefined}>
                      Код медицинской услуги: {item.medicalServiceCode}
                    </span>
                  )}
                </td>
                {showPrices && !noPriceAtAll ? (
                  <>
                    <td class="price-table__amount" data-label={hasTiered ? 'Врач' : 'Стоимость'}>{formatPrice(item.price) ?? '—'}</td>
                    {hasTiered && <td class="price-table__amount" data-label="Гл. врач">{item.priceHeadDoctor !== null ? formatPrice(item.priceHeadDoctor) : '—'}</td>}
                  </>
                ) : (
                  <td class="price-table__amount" colspan={hasTiered ? 2 : 1}>
                    {showPrices && item.note ? (
                      <span class="price-table__note">{item.note}</span>
                    ) : (
                      <button type="button" class="text-link price-table__cta" data-open-sheet data-context={contextLabel}>
                        Узнать цену <span>↗</span>
                      </button>
                    )}
                  </td>
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )
}

<style>
  .price-table {
    max-width: 760px;
  }
  .price-table__icd {
    margin: 0 0 16px;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .price-table table {
    width: 100%;
    border-collapse: collapse;
  }
  .price-table td {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.875rem;
    vertical-align: baseline;
  }
  .price-table__unit {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .price-table__service-code {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }
  .price-table__col-label {
    padding: 0 0 8px 20px;
    text-align: right;
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .price-table__amount {
    text-align: right;
    white-space: nowrap;
    padding-left: 20px;
    font: 400 1rem var(--display);
    color: var(--gold-deep);
  }
  .price-table__note {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .price-table__cta {
    gap: 8px;
    padding: 0;
    border: none;
    border-bottom: none;
    background: none;
    font-size: 0.6875rem;
  }
  .price-table__cta span {
    font-size: 0.875rem;
  }
  @media (max-width: 600px) {
    .price-table--cards table, .price-table--cards tbody { display: block; }
    .price-table--cards thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .price-table--cards tr { display: grid; grid-template-columns: minmax(0, 1fr); padding: 20px 0; border-bottom: 1px solid var(--line); gap: 10px; }
    .price-table--cards td { display: block; padding: 0; border: 0; overflow-wrap: anywhere; }
    .price-table--cards .price-table__amount { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; white-space: normal; text-align: left; }
    .price-table--cards .price-table__amount[data-label]::before { content: attr(data-label); font: 400 0.75rem var(--sans); color: var(--muted); }
    .price-table--cards .price-table__cta { min-height: 44px; font-size: 0.8125rem; }
  }
</style>
