---
import TelegramPost from './TelegramPost.astro';
import type { SpecialistMedia } from '../../lib/specialistMedia';
interface Props { items: SpecialistMedia[]; title: string; description?: string }
const { items, title, description } = Astro.props;
---
{items.length > 0 && <section class="specialist-media" data-specialist-media aria-labelledby="specialist-media-title">
  <header class="media-heading">
    <h2 id="specialist-media-title">{title}</h2>
    {description && <p>{description}</p>}
  </header>
  <ul class="media-rail" data-media-rail>
    {items.map((item, i) => <li class:list={["media-card", { "media-card--telegram": !!item.telegram_post }]} id={`specialist-media-${i}`}>
      {item.telegram_post ? <div class="telegram-card"><TelegramPost post={item.telegram_post} title={item.title} /><div class="media-copy"><h3>{item.title}</h3>{item.description && <p>{item.description}</p>}</div></div> : <a class="media-link" href={item.video_url || item.image_url} data-media-open data-video={item.video_url} data-poster={item.image_url} data-caption={item.title} data-alt={item.image_alt || item.title} data-captions={item.captions_url} aria-label={`${item.video_url ? 'Смотреть видео' : 'Открыть фото'}: ${item.title}`}>
        <div class="media-cover">
          <img src={item.image_url} alt={item.image_alt || item.title} width="720" height="480" style={`object-position:50% ${item.focus_y ?? 50}%`} loading="lazy" decoding="async" />
          {item.video_url && <span class="media-play" aria-hidden="true">▶</span>}
          <span class="media-type">{item.video_url ? 'Видео' : 'Фото'}</span>
        </div>
        <div class="media-copy"><h3>{item.title}</h3>{item.description && <p>{item.description}</p>}<span class="media-arrow" aria-hidden="true">↗</span></div>
      </a>}
    </li>)}
  </ul>
  {items.length > 1 && <nav class="media-pagination" aria-label="Материалы специалиста" data-media-pagination hidden>
    {items.map((item, i) => <button type="button" data-media-dot={i} aria-label={`Материал ${i + 1}: ${item.title}`} aria-current={i === 0 ? 'true' : undefined}><span /></button>)}
  </nav>}
  <dialog class="media-dialog" data-media-dialog aria-labelledby="media-dialog-title">
    <button class="media-close" type="button" data-media-close aria-label="Закрыть просмотр">×</button>
    <figure>
      <img class="media-full" data-media-image alt="" hidden />
      <video data-media-video controls playsinline preload="none" hidden><track kind="captions" srclang="ru" label="Русский" data-media-track /></video>
      <figcaption id="media-dialog-title" data-media-caption />
      <p data-media-error hidden>Не удалось загрузить материал. <a data-media-fallback>Открыть оригинал</a></p>
    </figure>
  </dialog>
</section>}
<script>
  import { initSpecialistMedia } from '../../scripts/specialist-media';
  initSpecialistMedia();
</script>
<style>
  .specialist-media { margin-top:clamp(40px,5vw,64px); min-width:0; }
  .media-heading { text-align:center; margin-bottom:28px; }
  h2 { margin:0 0 10px; font:400 clamp(32px,3.2vw,48px)/1.12 var(--display); text-wrap:balance; }
  .media-heading p { margin:0; color:var(--ink-2); font-size:16px; }
  .media-rail { list-style:none; padding:0; margin:0; display:grid; align-items:start; grid-template-columns:repeat(auto-fit,minmax(min(100%,350px),1fr)); gap:24px; }
  .telegram-card { padding-top:12px; }
  .media-card { min-width:0; border:1px solid var(--line-gold); border-radius:var(--radius); overflow:hidden; background:var(--gold-05); }
  .media-card:nth-child(3n+2) { background:var(--sand); }
  .media-card:nth-child(3n+3) { background:var(--gold-10); }
  .media-link { display:flex; flex-direction:column; height:100%; color:var(--ink); }
  .media-link:focus-visible { outline:3px solid var(--gold-deep); outline-offset:-4px; border-radius:var(--radius); }
  .media-cover { position:relative; aspect-ratio:3/2; overflow:hidden; }
  .media-cover img { display:block; width:100%; height:100%; object-fit:cover; transition:transform var(--dur-fast); }
  .media-link:hover img { transform:scale(1.025); }
  .media-play { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:60px; height:60px; display:grid; place-items:center; padding-left:4px; border-radius:50%; background:var(--paper); color:var(--gold-deep); font-size:23px; }
  .media-type { position:absolute; left:14px; bottom:14px; padding:5px 10px; border-radius:var(--radius-pill); background:var(--paper); color:var(--ink-2); font-size:11px; }
  .media-copy { position:relative; padding:20px 54px 24px 20px; flex:1; overflow-wrap:anywhere; }
  h3 { font:400 clamp(24px,2.1vw,30px)/1.1 var(--display); margin:0 0 10px; }
  .media-copy p { margin:0; font-size:14px; line-height:1.55; color:var(--ink-2); }
  .media-arrow { position:absolute; right:16px; top:20px; color:var(--gold-deep); font-size:22px; }
  .media-pagination { display:flex; justify-content:center; flex-wrap:wrap; margin-top:12px; }
  .media-pagination[hidden] { display:none; }
  .media-pagination button { border:0; background:transparent; width:44px; height:44px; display:grid; place-items:center; cursor:pointer; }
  .media-pagination span { width:9px; height:9px; border-radius:50%; background:var(--line); }
  .media-pagination [aria-current="true"] span { background:var(--gold-deep); }
  .media-dialog { width:min(1100px,calc(100% - 32px)); max-height:calc(100dvh - 32px); padding:64px 24px 24px; border:1px solid var(--line-gold); border-radius:var(--radius); background:var(--paper); color:var(--ink); }
  .media-dialog::backdrop { background:rgba(36,36,31,.8); }
  .media-close { position:absolute; top:12px; right:12px; width:44px; height:44px; border:1px solid var(--line-gold); border-radius:50%; background:var(--paper); color:var(--ink); font-size:28px; cursor:pointer; }
  figure { margin:0; text-align:center; }
  .media-full, video { display:block; width:100%; max-height:calc(100dvh - 190px); object-fit:contain; border-radius:12px; }
  [hidden] { display:none; }
  figcaption { margin-top:16px; font-size:16px; }
  [data-media-error] a { text-decoration:underline; }
  @media(max-width:800px) {
    .media-heading { text-align:left; margin-bottom:20px; }
    .media-heading p { font-size:14px; }
    .media-rail { display:flex; gap:14px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:thin; padding:2px 2px 10px; }
    .media-card { flex:0 0 84%; scroll-snap-align:start; }
    .media-card--telegram { flex-basis:100%; }
    .media-card:only-child { flex-basis:100%; }
    .media-copy { padding:18px 45px 20px 18px; }
    .media-dialog { padding:64px 12px 20px; }
  }
  @media(prefers-reduced-motion:reduce) { .media-cover img { transition:none; } }
</style>
