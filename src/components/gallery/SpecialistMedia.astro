---
import type { SpecialistMedia } from '../../lib/specialistMedia';
interface Props { items: SpecialistMedia[]; title: string; description?: string }
const { items, title, description } = Astro.props;
---
{items.length > 0 && <section class="specialist-media" data-specialist-media aria-labelledby="specialist-media-title">
  <header class="media-heading">
    <div><h2 id="specialist-media-title">{title}</h2>
    {description && <p>{description}</p>}</div>
    <nav class="media-controls" data-media-controls aria-label="Прокрутка материалов" hidden>
      <button type="button" data-media-prev aria-label="Предыдущие материалы" aria-controls="specialist-media-rail">←</button>
      <button type="button" data-media-next aria-label="Следующие материалы" aria-controls="specialist-media-rail">→</button>
    </nav>
  </header>
  <ul class="media-rail" id="specialist-media-rail" data-media-rail aria-label="Фото и видео специалиста">
    {items.map((item, i) => <li class="media-card" id={`specialist-media-${i}`}>
      <a class="media-link" href={item.video_url || item.image_url} data-media-open data-video={item.video_url} data-poster={item.image_url} data-caption={[item.title, item.description].filter(Boolean).join(' — ')} data-alt={item.image_alt || item.title} data-captions={item.captions_url} aria-label={`${item.video_url ? 'Смотреть видео' : 'Открыть фото'}: ${item.title}`}>
        <div class="media-cover">
          <img src={item.image_url} alt={item.image_alt || item.title} width="720" height="1280" style={`object-position:50% ${item.focus_y ?? 50}%`} loading="lazy" decoding="async" />
          {item.video_url && <span class="media-play" aria-hidden="true">▶</span>}
          <span class="media-type">{item.video_url ? 'Видео' : 'Фото'}</span>
        </div>
        <div class="media-copy"><h3>{item.title}</h3>{item.description && <p>{item.description}</p>}</div>
      </a>
    </li>)}
  </ul>
  <div class="media-pagination" data-media-pagination hidden>
    <div class="media-progress" aria-hidden="true"><span data-media-progress /></div>
    <p>Листайте, чтобы увидеть больше</p>
  </div>
  <dialog class="media-dialog" data-media-dialog aria-labelledby="media-dialog-title">
    <button class="media-close" type="button" data-media-close aria-label="Закрыть просмотр">×</button>
    <figure>
      <img class="media-full" data-media-image alt="" hidden />
      <video data-media-video controls playsinline preload="none" hidden><track kind="captions" srclang="ru" label="Русский" data-media-track /></video>
      <figcaption id="media-dialog-title" data-media-caption />
      <p data-media-error hidden>Не удалось загрузить материал. <a data-media-fallback>Открыть оригинал</a></p>
    </figure>
  </dialog>
</section>}
<script>
  import { initSpecialistMedia } from '../../scripts/specialist-media';
  // Module scripts run once under ClientRouter; the init is idempotent (root data-ready).
  document.addEventListener('astro:page-load', initSpecialistMedia);
</script>
<style>
  .specialist-media { margin-top:clamp(40px,5vw,64px); min-width:0; }
  .media-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; margin-bottom:28px; }
  h2 { margin:0 0 10px; font:400 clamp(32px,3.8vw,56px)/1.12 var(--display); text-wrap:balance; }
  .media-heading p { margin:0; color:var(--ink-2); font-size:16px; }
  .media-controls { display:flex; gap:12px; flex-shrink:0; }
  .media-controls button { width:48px; height:48px; border:1px solid var(--gold-deep); border-radius:50%; background:transparent; color:var(--gold-deep); font-size:24px; cursor:pointer; }
  .media-controls button:disabled { opacity:.35; cursor:default; }
  .media-controls button:focus-visible { outline:2px solid var(--gold-deep); outline-offset:3px; }
  .media-rail { list-style:none; padding:2px 2px 12px; margin:0; display:flex; gap:20px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:thin; scrollbar-color:var(--gold-deep) transparent; }
  [data-ready] .media-rail { scrollbar-width:none; }
  [data-ready] .media-rail::-webkit-scrollbar { display:none; }
  .media-card { position:relative; flex:0 0 calc((100% - 84px)/4.2); min-width:0; border-radius:22px; overflow:hidden; background:var(--sand); scroll-snap-align:start; }
  .media-link { position:relative; display:block; height:100%; color:#fff; text-decoration:none; }
  .media-link:focus-visible { outline:3px solid #fff; outline-offset:-6px; border-radius:22px; }
  .media-cover { position:relative; aspect-ratio:9/16; overflow:hidden; }
  .media-cover::after { content:""; position:absolute; inset:0; background:linear-gradient(180deg,rgba(0,0,0,.22),transparent 30%,transparent 40%,rgba(0,0,0,.84)); pointer-events:none; }
  .media-cover img { display:block; width:100%; height:100%; object-fit:cover; transition:transform var(--dur-fast) var(--ease-out); }
  @media (hover:hover) and (pointer:fine) { .media-link:hover img { transform:scale(1.025); } }
  .media-play { position:absolute; z-index:1; left:50%; top:50%; transform:translate(-50%,-50%); width:60px; height:60px; display:grid; place-items:center; padding-left:4px; border:1px solid #fff; border-radius:50%; background:rgba(0,0,0,.18); color:#fff; font-size:23px; }
  .media-type { position:absolute; z-index:1; left:16px; top:16px; padding:6px 11px; border-radius:var(--radius-pill); background:rgba(0,0,0,.45); color:#fff; font-size:12px; }
  .media-copy { position:absolute; z-index:1; bottom:0; left:0; right:0; padding:22px 18px; overflow-wrap:anywhere; }
  h3 { font:400 clamp(24px,2.1vw,30px)/1.1 var(--display); margin:0; }
  .media-copy p { margin:10px 0 0; font-size:13px; line-height:1.4; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
  .media-pagination { margin-top:16px; }
  .media-progress { height:3px; overflow:hidden; border-radius:3px; background:var(--line); }
  .media-progress span { display:block; height:100%; width:100%; background:var(--gold-deep); transform-origin:left; }
  .media-pagination p { margin:12px 0 0; font-size:12px; color:var(--ink-2); }
  .media-dialog { width:min(1100px,calc(100% - 32px)); max-height:calc(100dvh - 32px); padding:64px 24px 24px; border:1px solid var(--line-gold); border-radius:var(--radius); background:var(--paper); color:var(--ink); }
  .media-dialog::backdrop { background:rgba(36,36,31,.8); }
  /* Enter/exit as transitions (see ContactSheet.astro); unsupported browsers open instantly. */
  .media-dialog { opacity:0; transform:scale(0.97); transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), display var(--dur-fast) allow-discrete, overlay var(--dur-fast) allow-discrete; }
  .media-dialog[open] { opacity:1; transform:none; }
  @starting-style { .media-dialog[open] { opacity:0; transform:scale(0.97); } }
  .media-dialog::backdrop { opacity:0; transition: opacity var(--dur-fast) var(--ease-out), display var(--dur-fast) allow-discrete, overlay var(--dur-fast) allow-discrete; }
  .media-dialog[open]::backdrop { opacity:1; }
  @starting-style { .media-dialog[open]::backdrop { opacity:0; } }
  .media-close { position:absolute; top:12px; right:12px; width:44px; height:44px; border:1px solid var(--line-gold); border-radius:50%; background:var(--paper); color:var(--ink); font-size:28px; cursor:pointer; }
  figure { margin:0; text-align:center; }
  .media-full, video { display:block; width:100%; max-height:calc(100dvh - 190px); object-fit:contain; border-radius:12px; }
  [hidden] { display:none; }
  figcaption { margin-top:16px; font-size:16px; }
  [data-media-error] a { text-decoration:underline; }
  @media(max-width:1100px) { .media-card { flex-basis:calc((100% - 44px)/2.4); } }
  @media(max-width:600px) {
    .media-heading { align-items:flex-start; gap:12px; margin-bottom:20px; }
    .media-heading p { font-size:14px; }
    .media-controls { gap:6px; }
    .media-controls button { width:44px; height:44px; font-size:20px; }
    .media-rail { gap:14px; }
    .media-card { flex-basis:84%; max-width:340px; }
    .media-copy { padding:22px 18px; }
    .media-dialog { padding:64px 12px 20px; }
  }
  @media(max-width:400px) { .media-heading { flex-wrap:wrap; } }
  @media(prefers-reduced-motion:reduce) {
    .media-cover img { transition:none; }
    .media-link:hover img { transform:none; }
    .media-dialog { transform:none; transition:none; }
    .media-dialog::backdrop { transition:none; }
    @starting-style { .media-dialog[open] { transform:none; } }
  }
</style>
