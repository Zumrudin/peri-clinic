---
import type { GalleryItem, Specialist } from '../../lib/specialistContent';
interface Props { id: string; title: string; items: GalleryItem[]; portraits?: boolean; detailsLabel?: string; summaries?: Record<string, { specialty: string; reason: string }>; }
const { id, title, items, portraits = false, detailsLabel = 'Подробнее', summaries = {} } = Astro.props;
---
{items.length > 0 && <section class:list={['gallery', { portraits }]} data-gallery={id} aria-labelledby={`${id}-title`}>
  <div class="gallery-heading">
    <h3 id={`${id}-title`}>{title}</h3>
    <div class="gallery-nav" hidden>
      <button class="home-icon-button" type="button" data-prev aria-label="Предыдущая фотография">←</button>
      <button class="home-icon-button" type="button" data-next aria-label="Следующая фотография">→</button>
    </div>
  </div>
  <div class="gallery-rail" data-rail tabindex="0" aria-label={title}>
    {items.map(item => <article class="gallery-card" data-card>
      <a class="gallery-photo" href={item.full} data-photo data-id={item.id} data-caption={portraits ? `${item.title} · ${(item as Specialist).role}` : item.title} aria-label={`Увеличить фото: ${item.title}`}>
        <img src={item.thumbnail} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" style={`object-position: 50% ${portraits ? 100 : item.focus}%`} />
        {!portraits && <span class="room-caption">{item.title}</span>}
        <span class="photo-expand" aria-hidden="true">+</span>
      </a>
      {portraits && <div class="person-caption"><h4>{item.title}</h4><p>{(item as Specialist).role}</p>{summaries[(item as Specialist).slug] && <div class="person-expertise"><strong>{summaries[(item as Specialist).slug].specialty}</strong><p>{summaries[(item as Specialist).slug].reason}</p></div>}<a class="person-more home-text-link" href={`/specialisty/${(item as Specialist).slug}`}>{detailsLabel} <span aria-hidden="true">→</span></a></div>}
    </article>)}
  </div>
  <p class="visually-hidden" data-gallery-status aria-live="polite"></p>
</section>}
<style>
  .gallery { min-width: 0; }
  .gallery-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  h3 { margin: 0; font: 400 var(--home-card-title)/1.15 var(--display); text-wrap: balance; }
  .gallery-nav { display: flex; gap: 8px; flex-shrink: 0; }
  .gallery-nav[hidden] { display: none; }
  .gallery-rail { display: flex; gap: 24px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .gallery[data-interactive] .gallery-rail { overflow-x: hidden; scroll-snap-type: none; touch-action: pan-y; }
  .gallery[data-interactive] .gallery-photo { touch-action: pan-y; }
  .gallery-rail::-webkit-scrollbar { display: none; }
  .gallery-card { flex: 0 0 calc((100% - 48px) / 3); min-width: 0; display: flex; flex-direction: column; scroll-snap-align: start; }
  .gallery-photo { display: block; position: relative; border-radius: var(--radius); overflow: hidden; background: var(--sand); transition: transform var(--dur-press) var(--ease-out); }
  .gallery-photo:active { transform: scale(0.985); }
  .gallery-photo img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; user-select: none; }
  .portraits .gallery-card { flex-basis: calc((100% - 72px) / 4); }
  .portraits .gallery-photo { background: var(--specialist-photo-bg); }
  .portraits .gallery-photo img { aspect-ratio: 3 / 4; object-fit: contain; }
  .room-caption { position: absolute; bottom: 0; left: 0; right: 0; padding: 32px 16px 16px; color: white; background: linear-gradient(transparent,rgba(0,0,0,.65)); font-size: 14px; }
  .photo-expand { position: absolute; top: 12px; right: 12px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--paper); color: var(--ink); font-size: 22px; }
  .person-caption { flex: 1; display: flex; flex-direction: column; align-items: flex-start; padding-top: 16px; }
  h4 { font: 400 24px/1.2 var(--display); margin: 0 0 8px; }
  .person-caption p { color: var(--ink-2); font-size: 14px; line-height: 1.5; margin: 0 0 16px; }
  .person-more { margin-top: auto; }
  a:focus-visible, .gallery-rail:focus-visible { outline: 2px solid var(--gold-deep); outline-offset: -3px; }
  @media (max-width: 1100px) { .portraits .gallery-card { flex-basis: calc((100% - 48px) / 3); } }
  @media (max-width: 800px) {
    .gallery-rail { gap: 16px; }
    .gallery-card { flex-basis: 72%; }
    .portraits .gallery-card { flex-basis: 64%; }
    .gallery-heading { align-items: flex-start; }
  }
  @media (max-width: 600px) {
    .gallery-heading { flex-wrap: wrap; gap: 12px; }
    .gallery-nav { margin-left: auto; }
    .portraits .gallery-card { flex-basis: 82%; }
    .portraits .gallery-photo img { height: 280px; aspect-ratio: auto; }
  }
</style>
