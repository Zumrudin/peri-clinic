---
import type { GalleryItem, Specialist } from '../../lib/specialistContent';
interface Props { id: string; title: string; items: GalleryItem[]; portraits?: boolean; detailsLabel?: string; }
const { id, title, items, portraits = false, detailsLabel = 'Подробнее' } = Astro.props;
---
{items.length > 0 && <section class:list={['gallery', { portraits }]} data-gallery={id} aria-labelledby={`${id}-title`}>
  <div class="gallery-heading">
    <h3 id={`${id}-title`}>{title}</h3>
    <div class="gallery-nav" hidden>
      <button type="button" data-prev aria-label="Предыдущая фотография">←</button>
      <button type="button" data-next aria-label="Следующая фотография">→</button>
    </div>
  </div>
  <div class="gallery-rail" data-rail tabindex="0" aria-label={title}>
    {items.map(item => <article class="gallery-card" data-card>
      <a class="gallery-photo" href={item.full} data-photo data-id={item.id} data-caption={portraits ? `${item.title} · ${(item as Specialist).role}` : item.title} aria-label={`Увеличить фото: ${item.title}`}>
        <img src={item.thumbnail} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" style={`object-position: 50% ${portraits ? 100 : item.focus}%`} />
        {!portraits && <span class="room-caption">{item.title}</span>}
        <span class="photo-expand" aria-hidden="true">↗</span>
      </a>
      {portraits && <div class="person-caption"><h4>{item.title}</h4><p>{(item as Specialist).role}</p><a class="person-more" href={`/specialisty/${(item as Specialist).slug}`}>{detailsLabel} <span aria-hidden="true">↗</span></a></div>}
    </article>)}
  </div>
  <p class="visually-hidden" data-gallery-status aria-live="polite"></p>
</section>}
<style>
  .gallery { min-width: 0; margin-top: 42px; }
  .gallery-heading { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:22px; }
  h3 { margin:0; font:400 24px/1.2 var(--sans); }
  .portraits h3 { font:400 clamp(30px,3.5vw,54px)/1.1 var(--display); }
  .gallery-nav { display:flex; gap:10px; flex-shrink:0; }
  .gallery-nav[hidden] { display:none; }
  button { width:44px; height:44px; border:1px solid var(--gold); border-radius:50%; color:var(--gold-deep); background:transparent; cursor:pointer; font-size:23px; }
  button:hover { background:var(--sand); }
  .gallery-rail { display:flex; gap:18px; overflow-x:auto; overscroll-behavior-x:contain; scroll-snap-type:x mandatory; scrollbar-width:none; }
  /* JS rotates cards. Native snapping can undo that movement after a touch ends. */
  .gallery[data-interactive] .gallery-rail { overflow-x:hidden; scroll-snap-type:none; touch-action:pan-y; }
  .gallery[data-interactive] .gallery-photo { touch-action:pan-y; }
  .gallery-rail::-webkit-scrollbar { display:none; }
  .gallery-card { flex:0 0 calc((100% - 36px)/3); min-width:0; scroll-snap-align:start; }
  .gallery-photo { display:block; position:relative; border-radius:18px; overflow:hidden; background:var(--sand); }
  .gallery-photo img { width:100%; height:clamp(210px,24vw,350px); object-fit:cover; display:block; user-select:none; }
  .portraits .gallery-card { flex-basis:35%; }
  .portraits .gallery-photo { background:var(--specialist-photo-bg); }
  .portraits .gallery-photo img { height:auto; aspect-ratio:3/4; }
  .room-caption { position:absolute; bottom:0; left:0; right:0; padding:35px 18px 16px; color:white; background:linear-gradient(transparent,rgba(0,0,0,.65)); font-size:14px; }
  .photo-expand { position:absolute; top:12px; right:12px; display:grid; place-items:center; width:32px; height:32px; border-radius:50%; background:rgba(251,250,247,.9); color:var(--ink); }
  .person-caption { padding:18px 0 4px; }
  h4 { font:400 25px/1.2 var(--display); margin:0 0 5px; }
  .person-caption p { color:var(--muted); font-size:13px; margin:0 0 12px; }
  .person-more { display:inline-flex; gap:20px; align-items:center; padding:9px 16px; border:1px solid var(--line-gold); border-radius:999px; font-size:13px; color:var(--gold-deep); }
  .person-more:hover { background:var(--sand); }
  a:focus-visible,button:focus-visible,.gallery-rail:focus-visible { outline:2px solid var(--gold-deep); outline-offset:3px; }
  @media (max-width:1100px) { .portraits .gallery-card { flex-basis:43%; } }
  @media (min-width:801px) {
    .gallery { margin:0; }
    .gallery-heading { margin-bottom:16px; gap:20px; }
    h3 { font-size:22px; }
    .portraits h3 { font-size:clamp(30px,3vw,44px); }
    .gallery-rail { gap:20px; }
    .gallery-card { flex-basis:calc((100% - 40px)/3); }
    .gallery-photo { border-radius:16px; }
    .gallery-photo img { height:clamp(150px,20vh,220px); }
    .portraits .gallery-rail { justify-content:space-between; }
    .portraits .gallery-card { flex:0 0 min(32%,320px); }
    .portraits .gallery-photo img { height:auto; aspect-ratio:3/4; object-fit:contain; }
    .person-caption { padding:12px 0 0; }
    h4 { font-size:23px; }
    .person-caption p { margin-bottom:8px; }
    .person-more { padding:6px 12px; }
  }
  @media (max-width:600px) {
    .gallery { margin-top:24px; }
    .gallery-heading { gap:10px; margin-bottom:12px; }
    h3 { font-size:16px; }
    .portraits h3 { font-size:22px; line-height:1.08; }
    .gallery-rail { gap:8px; }
    .gallery-card { flex-basis:calc((100% - 16px)/3); }
    .portraits .gallery-card { flex-basis:35%; }
    .gallery-photo { border-radius:10px; }
    .gallery-photo img { height:clamp(108px,32vw,190px); }
    .gallery-nav { gap:4px; }
    .photo-expand { width:24px; height:24px; top:6px; right:6px; font-size:13px; }
    .room-caption { padding:24px 7px 9px; font-size:11px; line-height:1.2; }
    .person-caption { padding:10px 0 2px; }
    h4 { font-size:18px; line-height:1.15; overflow-wrap:anywhere; }
    .person-caption p { font-size:11px; line-height:1.4; margin-bottom:8px; }
    .person-more { gap:8px; padding:9px 10px; font-size:12px; }
  }
</style>
