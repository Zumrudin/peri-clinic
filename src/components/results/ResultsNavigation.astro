---
interface Props { count: number; railId: string }
const { count, railId } = Astro.props;
---
  {count > 1 && <div class="results-navigation" data-results-navigation hidden>
    <div class="results-navigation__position">
      <div class="results-navigation__track" aria-hidden="true"><span data-results-progress /></div>
      <p class="results-navigation__counter" aria-live="polite" aria-atomic="true"><span data-results-current>01</span><span aria-hidden="true"> / </span><span class="visually-hidden"> из </span>{String(count).padStart(2, '0')}</p>
    </div>
    <div class="results-navigation__arrows">
      <button type="button" data-results-prev aria-label="Предыдущая работа" aria-controls={railId} disabled><span aria-hidden="true">←</span></button>
      <button type="button" data-results-next aria-label="Следующая работа" aria-controls={railId}><span aria-hidden="true">→</span></button>
    </div>
  </div>}

<style>
  .results-navigation { display: none; }
  @media (max-width: 800px) {

    .results-navigation:not([hidden]) { display: flex; align-items: center; gap: 24px; margin-top: 12px; }
    .results-navigation__position { flex: 1; min-width: 0; }
    .results-navigation__track { height: 2px; background: var(--line-gold); border-radius: var(--radius-pill); overflow: hidden; }
    .results-navigation__track span { display: block; width: 100%; height: 100%; background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform var(--dur-fast); }
    .results-navigation__counter { margin: 14px 0 0; color: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; letter-spacing: 0.12em; }
    .results-navigation__counter > span:first-child { color: var(--gold-deep); }
    .results-navigation__arrows { display: flex; gap: 10px; }
    .results-navigation button { display: grid; place-items: center; width: 46px; height: 46px; padding: 0; border: 1px solid var(--gold-deep); border-radius: 50%; background: transparent; color: var(--gold-deep); font-size: 23px; cursor: pointer; transition: transform var(--dur-press) var(--ease-out); }
    .results-navigation button:active:not(:disabled) { transform: scale(0.94); }
    .results-navigation button:disabled { opacity: 0.4; cursor: default; }
    button:focus-visible { outline: 2px solid var(--gold-deep); outline-offset: 4px; }
  }
</style>
