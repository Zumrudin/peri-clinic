---
import { Image, getImage } from 'astro:assets';

interface ImgRef {
  src: string;
  width: number;
  height: number;
}
interface Props {
  title: string;
  preserveAspect?: boolean;
  preserveMobileAspect?: boolean;
  mobileHomeStyle?: boolean;
  result?: string;
  category?: string;
  categorySlug?: string;
  before?: ImgRef | null;
  after?: ImgRef | null;
  combined?: ImgRef | null;
}
const { title, result, category, categorySlug, before, after, combined, preserveAspect = false, preserveMobileAspect = false, mobileHomeStyle = false } = Astro.props;
const hasPair = before && after;
const single = combined ?? after ?? before;
const imageHeight = (img: ImgRef, width: number, fallback: number) => preserveAspect && img.width > 0 && img.height > 0 ? Math.round(width * img.height / img.width) : fallback;
// Desktop assets are cropped during optimization; mobile needs the full source
// as well as object-fit: contain, just like the home page's results cards.
const mobileImages = new Map(await Promise.all(
  (preserveMobileAspect ? (hasPair ? [before!, after!] : single ? [single] : []) : []).map(async (img) => {
    const widths = [480, 700, 1000];
    const images = await Promise.all(widths.map(width => getImage({
      src: img.src,
      width,
      height: Math.round(width * img.height / img.width),
      format: 'webp',
    })));
    return [img.src, images.map((image, i) => `${image.src} ${widths[i]}w`).join(', ')] as const;
  }),
));
---

<article class:list={['case-card reveal', { 'case-card--uncropped': preserveAspect, 'case-card--mobile-uncropped': preserveMobileAspect, 'case-card--home-mobile': mobileHomeStyle }]} data-category={categorySlug ?? ''}>
  {
    hasPair ? (
      <div class="case-card__pair">
        <div class="case-card__half">
          <picture>
          {mobileImages.has(before!.src) && <source media="(max-width: 800px)" type="image/webp" srcset={mobileImages.get(before!.src)} sizes="43vw" width={before!.width} height={before!.height} />}
          <Image src={before!.src} alt={`${title} — до`} width={500} height={imageHeight(before!, 500, 620)} sizes="(max-width: 800px) 43vw, 220px" loading="lazy" />
          </picture>
          <span class="glass-chip">до</span>
        </div>
        <div class="case-card__half">
          <picture>
          {mobileImages.has(after!.src) && <source media="(max-width: 800px)" type="image/webp" srcset={mobileImages.get(after!.src)} sizes="43vw" width={after!.width} height={after!.height} />}
          <Image src={after!.src} alt={`${title} — после`} width={500} height={imageHeight(after!, 500, 620)} sizes="(max-width: 800px) 43vw, 220px" loading="lazy" />
          </picture>
          <span class="glass-chip">после</span>
        </div>
      </div>
    ) : single ? (
      <div class="case-card__image">
        <picture>
        {mobileImages.has(single.src) && <source media="(max-width: 800px)" type="image/webp" srcset={mobileImages.get(single.src)} sizes="86vw" width={single.width} height={single.height} />}
        <Image src={single.src} alt={title} width={700} height={imageHeight(single, 700, 620)} sizes="(max-width: 800px) 86vw, 30vw" loading="lazy" />
        </picture>
        <span class="glass-chip">до / после</span>
      </div>
    ) : null
  }
  <div class="case-card__body">
    {category && <p class="case-card__category glass-chip">{category}</p>}
    <h3>{title}</h3>
    {result && <p class="case-card__result">{result}</p>}
  </div>
</article>

<style>
  picture { display: contents; }
  .case-card {
    background: var(--gold-05);
    border: 1px solid var(--line-gold);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast);
  }
  .case-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-gold);
  }
  .case-card__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }
  .case-card__half,
  .case-card__image {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .case-card__half :global(img),
  .case-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .case-card__half span,
  .case-card__image span {
    position: absolute;
    left: 10px;
    bottom: 10px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .case-card--uncropped .case-card__half,
  .case-card--uncropped .case-card__image {
    aspect-ratio: auto;
  }
  .case-card--uncropped :global(img) {
    height: auto;
    object-fit: contain;
  }
  .case-card__body {
    padding: 24px;
  }
  .case-card__category {
    margin: 0 0 10px;
    color: var(--gold-deep);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .case-card h3 {
    font: 400 24px var(--display);
    margin: 0 0 10px;
  }
  .case-card__result {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
  }
  @media (max-width: 800px) {
    .case-card--mobile-uncropped .case-card__half,
    .case-card--mobile-uncropped .case-card__image {
      background: var(--paper);
    }
    .case-card--mobile-uncropped .case-card__image { aspect-ratio: 1; }
    .case-card--mobile-uncropped :global(img) {
      object-fit: contain;
      display: block;
    }
    .case-card--mobile-uncropped .case-card__half span,
    .case-card--mobile-uncropped .case-card__image span {
      display: none;
    }
  }
  @media (max-width: 800px) {
    .case-card--home-mobile {
      flex: 0 0 var(--results-card-width);
      display: flex;
      flex-direction: column;
      min-width: 0;
      background: var(--paper);
      border: 0;
      box-shadow: var(--shadow-soft);
      scroll-snap-align: start;
      scroll-snap-stop: always;
      opacity: 1;
      transform: none;
    }
    .case-card--home-mobile:hover { transform: none; box-shadow: var(--shadow-glow); }
    .case-card--home-mobile .case-card__image,
    .case-card--home-mobile .case-card__pair { aspect-ratio: 1; flex: none; }
    .case-card--home-mobile .case-card__half { min-width: 0; min-height: 0; }
    .case-card--home-mobile :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
    .case-card--home-mobile .case-card__image > span { display: none; }
    .case-card--home-mobile .case-card__body { display: flex; flex-direction: column; justify-content: center; min-height: 104px; padding: 14px; flex: 1; }
    .case-card--home-mobile h3 { font-size: 22px; line-height: 1.15; margin-bottom: 6px; }
    .case-card--home-mobile .case-card__result { font-size: 12px; }
  }
</style>
