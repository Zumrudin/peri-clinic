---
import { em } from '../../lib/markup';

interface Props {
  home?: boolean;
  eyebrow: string;
  title: string;
  lead?: string;
  id?: string;
  /** 'grid' = eyebrow spans, title left, lead right-bottom (draft default); 'block' = stacked */
  layout?: 'grid' | 'block';
  class?: string;
}
const { home = false, eyebrow, title, lead, id, layout = 'grid', class: className } = Astro.props;
---

<div class:list={['section-heading', { 'section-heading--home': home }, `section-heading--${layout}`, 'reveal', className]}>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={id} set:html={em(title)} />
  </div>
  {lead && <p class="section-heading__lead">{lead}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: 66px;
  }
  .section-heading--grid {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 400px);
    align-items: end;
    gap: 24px 40px;
  }
  .section-heading__lead {
    margin: 0 0 5px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }
  @media (max-width: 800px) {
    .section-heading,
    .section-heading--grid {
      display: block;
      margin-bottom: 35px;
    }
    .section-heading__lead {
      margin-top: 25px;
      font-size: 13px;
    }
  }
  .section-heading--home { margin-bottom: 32px; }
  .section-heading--home .section-heading__lead { margin: 0; color: var(--ink-2); font-size: 16px; line-height: 1.6; max-width: 60ch; }
  .section-heading--home.section-heading--block .section-heading__lead { margin-top: 16px; }
  @media (max-width: 1000px) {
    .section-heading--home { display: block; }
    .section-heading--home .section-heading__lead { margin-top: 16px; }
  }
</style>
