---
import JsonLd from './JsonLd.astro';
import { breadcrumbJsonLd } from '../../lib/seo';

interface Props {
  items: Array<{ name: string; href: string }>;
}
const { items } = Astro.props;
const withHome = [{ name: 'Главная', href: '/' }, ...items];
const jsonLd = breadcrumbJsonLd(withHome.map((i) => ({ name: i.name, url: new URL(i.href, Astro.site).href })));
---

<JsonLd data={jsonLd} />
