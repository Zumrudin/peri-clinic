---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import { em } from '../../lib/markup';
import { homeImage } from '../../lib/images';
import home from '../../data/home.json';

const { categories } = home;
---

<section class="section services" id="services">
  <SectionHeading eyebrow={categories.eyebrow} title={categories.title} lead={categories.lead} />

  <div class="service-grid rail">
    {
      categories.items.map((item, i) => (
        <a class="service-card reveal" href={`/${item.slug}`}>
          <Image
            src={homeImage(item.cover)}
            alt={item.alt}
            width={700}
            height={900}
            widths={[420, 700, 1000]}
            sizes="(max-width: 800px) 84vw, 33vw"
            loading="lazy"
          />
          <span class="service-card__number">{String(i + 1).padStart(2, '0')}</span>
          <div class="service-card__content">
            <p>{item.tagline}</p>
            <h3 set:html={em(item.title)} />
            <span class="round-arrow" aria-hidden="true">
              ↗
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    overflow: visible;
  }
  .service-card {
    height: 610px;
    position: relative;
    overflow: hidden;
    background: #282722;
    color: #fff;
    border-radius: var(--radius);
  }
  .service-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 20, 17, 0.05) 28%, rgba(20, 20, 17, 0.76) 100%);
  }
  .service-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.8);
    transition:
      transform var(--dur-slow) var(--ease-out),
      filter 0.5s;
  }
  .service-card:hover :global(img) {
    transform: scale(1.045);
    filter: saturate(1);
  }
  .service-card__number {
    position: absolute;
    z-index: 2;
    top: 22px;
    left: 24px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    font-size: 11px;
  }
  .service-card__content {
    position: absolute;
    z-index: 2;
    inset: auto 28px 30px;
  }
  .service-card__content p {
    margin-bottom: 16px;
    font-size: 11px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .service-card__content h3 {
    margin: 0;
    font: 400 var(--t-h3) / 1.02 var(--display);
  }
  .round-arrow {
    position: absolute;
    right: 0;
    bottom: 1px;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 19px;
    transition:
      background var(--dur-fast),
      color var(--dur-fast),
      transform var(--dur-fast);
  }
  .service-card:hover .round-arrow {
    background: #fff;
    color: var(--ink);
    transform: rotate(45deg);
  }

  @media (max-width: 1100px) {
    .service-card {
      height: 520px;
    }
  }
  @media (max-width: 800px) {
    .service-grid {
      display: flex;
      overflow-x: auto;
      gap: 10px;
      margin-right: -18px;
      padding-right: 18px;
    }
    .service-card {
      flex: 0 0 84vw;
      height: 520px;
      scroll-snap-align: center;
    }
    .service-card__content h3 {
      font-size: 31px;
    }
  }
</style>
