---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { em } from '../../lib/markup';
import { getHomeContent } from '../../lib/homeContent';
import tileApparatnaya from '../../assets/home/tiles/apparatnaya.jpg';
import tileInjekcionnaya from '../../assets/home/tiles/injekcionnaya.jpg';
import tileEsteticheskaya from '../../assets/home/tiles/esteticheskaya.jpg';

const home = await getHomeContent();
const { categories } = home;

// Mobile-only art-direction crops (see docs/superpowers/specs/2026-09-12-directions-mobile-tiles-design.md).
// Keyed by slug, not index, so a future re-ordering of service_categories in Directus
// doesn't silently pair the wrong crop with the wrong card.
const mobileTileBySlug: Record<string, ImageMetadata> = {
  'apparatnaya-kosmetologiya': tileApparatnaya,
  'injekcionnaya-cosmetologiya': tileInjekcionnaya,
  'esteticheskaya-kosmetologiya': tileEsteticheskaya,
};

const mobileTiles = await Promise.all(
  categories.items.map((item) => {
    const source = mobileTileBySlug[item.slug];
    return source ? getImage({ src: source, widths: [380, 472], format: 'jpg' }) : null;
  }),
);
---

<section class="home-section section services" id="services">
  <SectionHeading home eyebrow={categories.eyebrow} title={categories.title} lead={categories.lead} class="services__heading" />

  <div class="service-grid">
    {
      categories.items.map((item, i) => {
        const mobileTile = mobileTiles[i];
        return (
          <a class="service-card reveal" href={`/${item.slug}`}>
            <picture>
              {mobileTile && (
                <source
                  media="(max-width: 800px)"
                  srcset={mobileTile.srcSet.attribute}
                  sizes="(max-width: 600px) 100vw, 50vw"
                />
              )}
              <Image
                src={item.cover.src}
                alt={item.alt}
                width={item.slug === 'esteticheskaya-kosmetologiya' ? item.cover.width : 700}
                height={item.slug === 'esteticheskaya-kosmetologiya' ? item.cover.height : 900}
                widths={[420, 700, 1000]}
                sizes="(max-width: 800px) 84vw, 33vw"
                loading="lazy"
              />
            </picture>
            <div class="service-card__content">
              <p>{item.tagline}</p>
              <h3 set:html={em(item.title)} />
              <span class="round-arrow" aria-hidden="true">
                →
              </span>
            </div>
          </a>
        );
      })
    }
  </div>

  <div class="services__hint">
    <p class="services__hint-title">Не знаете, что выбрать?</p>
    <button type="button" class="services__hint-cta home-text-link" data-open-sheet data-context="Консультация">
      Начните с консультации <span aria-hidden="true">→</span>
    </button>
  </div>
</section>

<style>
  .service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .service-card { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border-radius: var(--radius-lg); background: var(--sand); }
  .service-card:nth-child(3n+2) { background: var(--home-surface-warm); }
  .service-card:nth-child(3n+3) { background: var(--home-surface-cool); }
  .service-card picture { display: block; aspect-ratio: 4 / 3; overflow: hidden; }
  .service-card :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-slow) var(--ease-out); }
  /* Hover feedback on the link-card: a slow 3% zoom, same family as SpecialistMedia's cover. */
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover :global(img) { transform: scale(1.03); }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-card:hover :global(img) { transform: none; }
  }
  .service-card__content { flex: 1; display: flex; flex-direction: column; align-items: flex-start; padding: 24px; }
  .service-card__content h3 { order: 0; margin: 0; font: 400 var(--home-card-title)/1.12 var(--display); }
  .service-card__content p { order: 1; margin: 12px 0 20px; font-size: 15px; line-height: 1.6; color: var(--ink-2); }
  .round-arrow { order: 2; display: grid; place-items: center; align-self: flex-end; margin-top: auto; width: 48px; height: 48px; border-radius: 50%; background: var(--gold-deep); color: white; font-size: 24px; transition: background var(--dur-fast); }
  .service-card:hover .round-arrow { background: var(--gold-hover); }
  .services__hint { display: flex; align-items: center; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap; margin-top: 24px; padding: 20px 24px; border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .services__hint-title { margin: 0; font-size: 16px; }
  @media (min-width: 601px) and (max-width: 1100px) {
    .service-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .service-card:first-child { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; }
    .service-card:first-child picture { height: 100%; aspect-ratio: auto; }
  }
  @media (max-width: 600px) {
    .service-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .service-card__content { padding: 20px; }
    .services__hint { display: block; padding: 20px; }
    .services__hint-title { margin-bottom: 8px; }
  }
</style>
