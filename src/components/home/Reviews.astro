---
import { em } from '../../lib/markup';
import { getHomeContent } from '../../lib/homeContent';

const home = await getHomeContent();
const { reviews } = home;
const stars = '★★★★★';
---

<section class="home-section reviews" id="reviews" aria-labelledby="reviews-title" data-rail-root>

  <div class="reviews__head reveal">
    <p class="eyebrow">{reviews.eyebrow}</p>
    <h2 id="reviews-title" set:html={em(reviews.title)} />
    <div class="rating">
      <strong>{reviews.rating}</strong>
      <span>
        <span aria-label={`Оценка ${reviews.rating} из 5`}>{stars}</span>
        <small>{reviews.rating_label}</small>
      </span>
    </div>
  </div>
  <div class="review-list rail" data-rail tabindex="0" role="group" aria-label="Отзывы пациентов">
    {
      reviews.items.map((r) => (
        <article class="review-card reveal">
          <div class="review-card__top">
            <span aria-label="5 из 5">{stars}</span>
            <small>{r.date}</small>
          </div>
          <blockquote>«{r.text}»</blockquote>
          <div class="review-card__author">
            <span aria-hidden="true">{r.author.charAt(0)}</span>
            <p>
              <strong>{r.author}</strong>
              <small>{r.procedure_label}</small>
            </p>
          </div>
        </article>
      ))
    }
  </div>
  <div class="reviews__controls">
    <button class="home-icon-button" type="button" data-rail-prev aria-label="Предыдущий отзыв">←</button>
    <button class="home-icon-button" type="button" data-rail-next aria-label="Следующий отзыв">→</button>
  </div>
</section>

<style>
  .reviews { background: var(--dark); color: var(--dark-text); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 32px 48px; }
  .reviews .eyebrow { color: var(--gold-light); }
  .rating { display: flex; align-items: center; gap: 20px; margin-top: 32px; }
  .rating > strong { font: 56px/1 var(--display); }
  .rating > span { color: var(--gold-light); font-size: 14px; letter-spacing: .08em; }
  .rating small { display: block; color: #c8c5ba; font-size: 12px; letter-spacing: 0; margin-top: 8px; }
  .review-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; overflow: visible; min-width: 0; }
  .review-card { min-width: 0; padding: 24px; display: flex; flex-direction: column; border: 1px solid var(--line-on-dark); border-radius: var(--radius-lg); background: rgba(255,255,255,.03); }
  .review-card:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .review-card__top { display: flex; justify-content: space-between; gap: 12px; color: var(--gold-light); font-size: 13px; }
  .review-card__top small { color: #c8c5ba; font-size: 12px; }
  .review-card blockquote { font: 22px/1.5 var(--display); margin: 24px 0; }
  .review-card__author { display: flex; align-items: center; gap: 12px; margin-top: auto; }
  .review-card__author > span { width: 36px; height: 36px; flex-shrink: 0; border-radius: 50%; display: grid; place-items: center; background: var(--gold-deep); color: white; font: 18px var(--display); }
  .review-card__author p { margin: 0; }
  .review-card__author strong, .review-card__author small { display: block; font-size: 14px; }
  .review-card__author small { margin-top: 4px; color: #c8c5ba; }
  .reviews__controls { display: none; }
  .review-list:focus-visible { outline: 2px solid var(--gold-light); outline-offset: -3px; }
  @media (max-width: 1100px) { .reviews { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 800px) {
    .reviews { display: block; }
    .rating { margin: 24px 0 32px; }
    .review-list { display: flex; overflow-x: auto; gap: 16px; margin-right: calc(-1 * var(--gutter)); padding-right: var(--gutter); }
    .review-card { flex: 0 0 min(82vw, 440px); scroll-snap-align: start; }
    .reviews__controls { display: flex; gap: 8px; margin-top: 24px; }
    .reviews__controls .home-icon-button { color: var(--gold-light); border-color: var(--gold-light); }
  }
</style>
