---
import { em } from '../../lib/markup';
import { getHomeContent } from '../../lib/homeContent';

const home = await getHomeContent();
const { reviews } = home;
const stars = '★★★★★';
---

<section class="reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="glow" aria-hidden="true">
    <span class="glow__blob"></span>
    <span class="glow__blob glow__blob--b"></span>
  </div>

  <div class="reviews__head reveal">
    <p class="eyebrow">{reviews.eyebrow}</p>
    <h2 id="reviews-title" set:html={em(reviews.title)} />
    <div class="rating">
      <strong>{reviews.rating}</strong>
      <span>
        <span aria-label={`Оценка ${reviews.rating} из 5`}>{stars}</span>
        <small>{reviews.rating_label}</small>
      </span>
    </div>
  </div>
  <div class="review-list rail">
    {
      reviews.items.map((r) => (
        <article class="review-card glass-panel glass-panel--dark reveal">
          <div class="review-card__top">
            <span aria-label="5 из 5">{stars}</span>
            <small>{r.date}</small>
          </div>
          <blockquote>«{r.text}»</blockquote>
          <div class="review-card__author">
            <span aria-hidden="true">{r.author.charAt(0)}</span>
            <p>
              <strong>{r.author}</strong>
              <small>{r.procedure_label}</small>
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .reviews {
    background: var(--dark);
    color: var(--dark-text);
    padding: 130px var(--gutter-wide);
    display: grid;
    grid-template-columns: 32% 68%;
    gap: 4vw;
    position: relative;
    overflow: hidden;
  }
  .reviews__head,
  .review-list {
    position: relative;
    z-index: 1;
  }
  .reviews .eyebrow {
    color: var(--gold-light);
  }
  .reviews h2 {
    font-size: var(--t-h2-s);
  }
  .reviews h2 :global(em) {
    color: var(--gold-light);
  }
  .rating {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 55px;
  }
  .rating > strong {
    font: 55px var(--display);
  }
  .rating > span {
    color: var(--gold-light);
    font-size: 13px;
    letter-spacing: 0.12em;
  }
  .rating small {
    display: block;
    color: #a4a197;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 7px;
  }
  .review-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    overflow: visible;
  }
  .review-card {
    min-height: 300px;
    padding: 28px;
    display: flex;
    flex-direction: column;
  }
  .review-card:last-child {
    grid-column: 1 / -1;
    min-height: 260px;
  }
  .review-card__top {
    display: flex;
    justify-content: space-between;
    color: var(--gold-light);
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .review-card__top small {
    color: #a4a197;
    letter-spacing: 0;
    font-size: 11px;
  }
  .review-card blockquote {
    font: 20px/1.45 var(--display);
    margin: 34px 0;
  }
  .review-card__author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }
  .review-card__author > span {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--gold);
    color: #fff;
    font: 15px var(--display);
    box-shadow: var(--shadow-glow);
  }
  .review-card__author p {
    margin: 0;
  }
  .review-card__author strong,
  .review-card__author small {
    display: block;
    font-size: 12px;
  }
  .review-card__author small {
    margin-top: 3px;
    color: #a4a197;
    font-size: 11px;
  }

  @media (max-width: 1100px) {
    .reviews {
      grid-template-columns: 36% 64%;
    }
  }
  @media (max-width: 800px) {
    .reviews {
      display: block;
      padding: 85px 18px;
    }
    .rating {
      margin: 30px 0 40px;
    }
    .review-list {
      display: flex;
      overflow-x: auto;
      gap: 10px;
      margin-right: -18px;
      padding-right: 18px;
    }
    .review-card,
    .review-card:last-child {
      flex: 0 0 86vw;
      min-height: 310px;
      grid-column: auto;
      scroll-snap-align: center;
    }
    .review-card blockquote {
      font-size: 18px;
    }
  }
</style>
