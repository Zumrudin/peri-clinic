---
import { em } from '../../lib/markup';
import { getClinicPhotos, getSpecialists, getAboutContent } from '../../lib/specialistContent';
import Gallery from '../gallery/Gallery.astro';
import Lightbox from '../gallery/Lightbox.astro';
const [content, rooms, team] = await Promise.all([getAboutContent(), getClinicPhotos(), getSpecialists()]);
---
<section class="home-section approach" id="approach" aria-labelledby="approach-title">
  <div class="approach-intro">
    <div><p class="eyebrow">{content.eyebrow}</p><h2 id="approach-title" set:html={em(content.title)} /></div>
    <p class="approach-description">{content.description}</p>
  </div>
  <Gallery id="clinic-rooms" title={content.rooms_title} items={rooms} />
  <div id="approach-team"><Gallery id="clinic-team" title={content.team_title} items={team} portraits detailsLabel={content.details_label} /></div>
  {content.license_href && content.license_label && <a class="legal-link home-text-link" href={content.license_href}>{content.license_label}</a>}
</section>
<Lightbox />
<style>
  .approach { background: var(--paper); }
  .approach-intro { display: grid; grid-template-columns: 1fr minmax(280px, 400px); align-items: end; gap: 24px 40px; margin-bottom: 40px; }
  .approach-description { margin: 0; max-width: 60ch; font-size: 1rem; line-height: 1.6; color: var(--ink-2); }
  #approach-team { margin-top: 48px; scroll-margin-top: calc(var(--header-h-sticky) + 24px); }
  .legal-link { margin-top: 24px; }
  @media (max-width: 1000px) {
    .approach-intro { grid-template-columns: minmax(0, 1fr); gap: 16px; margin-bottom: 32px; }
  }
  @media (max-width: 800px) { #approach-team { margin-top: 40px; } }
</style>
