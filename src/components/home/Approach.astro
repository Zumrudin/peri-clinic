---
import { em } from '../../lib/markup';
import { getHomeContent } from '../../lib/homeContent';
import { getClinicPhotos, getSpecialists, aboutDemo } from '../../lib/specialistContent';
import Gallery from '../gallery/Gallery.astro';
import Lightbox from '../gallery/Lightbox.astro';
const [{ approach }, rooms, team] = await Promise.all([getHomeContent(), getClinicPhotos(), getSpecialists()]);
---
<section class="approach" id="approach" aria-labelledby="approach-title">
  <div class="approach-intro">
    <div><p class="eyebrow">О клинике</p><h2 id="approach-title" set:html={em(aboutDemo ? 'Место, где вам\nуделяют внимание' : approach.title)} /></div>
    <p class="approach-description">{aboutDemo ? 'PERI CLINIC — пространство современной косметологии. Знакомимся с вами, обсуждаем пожелания и составляем понятный план процедур.' : approach.lead}</p>
  </div>
  <Gallery id="clinic-rooms" title="Пространство клиники" items={rooms} />
  <div id="approach-team"><Gallery id="clinic-team" title="Люди, которым можно довериться" items={team} portraits /></div>
  <a class="legal-link" href="/yuridicheskaya-informaciya">Лицензия и документы ↗</a>
  {(rooms.some(p => p.demo) || team.some(p => p.demo)) && <p class="demo-note">Дизайн-концепция: фотографии и профили временные.</p>}
</section>
<Lightbox />
<style>
  .approach { padding:90px var(--gutter) var(--section); background:var(--paper); }
  .approach-intro { display:grid; grid-template-columns:1.2fr 1fr; align-items:center; gap:8%; }
  h2 { font-size:clamp(42px,4.7vw,72px); line-height:1; margin:0; }
  .approach-description { font-size:17px; line-height:1.75; margin:24px 0 0; max-width:560px; }
  #approach-team { scroll-margin-top:110px; }
  .legal-link { display:inline-block; margin-top:28px; font-size:13px; color:var(--gold-deep); text-decoration:underline; text-underline-offset:5px; }
  .demo-note { margin:28px 0 0; padding-top:16px; border-top:1px solid var(--line); color:var(--muted); font-size:12px; }
  @media(max-width:800px) { .approach { padding:60px 18px; } .approach-intro { grid-template-columns:1fr; gap:0; } .approach-description { font-size:15px; } }
</style>
