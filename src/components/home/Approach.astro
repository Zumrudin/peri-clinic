---
import { em } from '../../lib/markup';
import { getClinicPhotos, getSpecialists, getAboutContent } from '../../lib/specialistContent';
import Gallery from '../gallery/Gallery.astro';
import Lightbox from '../gallery/Lightbox.astro';
const [content, rooms, team] = await Promise.all([getAboutContent(), getClinicPhotos(), getSpecialists()]);
---
<section class="approach" id="approach" aria-labelledby="approach-title">
  <div class="approach-intro">
    <div><p class="eyebrow">{content.eyebrow}</p><h2 id="approach-title" set:html={em(content.title)} /></div>
    <p class="approach-description">{content.description}</p>
  </div>
  <Gallery id="clinic-rooms" title={content.rooms_title} items={rooms} />
  <div id="approach-team"><Gallery id="clinic-team" title={content.team_title} items={team} portraits detailsLabel={content.details_label} /></div>
  {content.license_href && content.license_label && <a class="legal-link" href={content.license_href}>{content.license_label}</a>}
</section>
<Lightbox />
<style>
  .approach { padding:90px var(--gutter) var(--section); background:var(--paper); }
  .approach-intro { display:grid; grid-template-columns:1.2fr 1fr; align-items:center; gap:8%; }
  h2 { font-size:clamp(42px,4.7vw,72px); line-height:1; margin:0; }
  .approach-description { font-size:17px; line-height:1.75; margin:24px 0 0; max-width:560px; }
  #approach-team { scroll-margin-top:110px; }
  .legal-link { display:inline-block; margin-top:28px; font-size:13px; color:var(--gold-deep); text-decoration:underline; text-underline-offset:5px; }
  @media(min-width:801px) {
    .approach {
      display:grid;
      grid-template-rows:auto auto auto auto;
      gap:24px;
      height:auto;
      width:100%;
      max-width:var(--container);
      margin-inline:auto;
      padding:48px var(--gutter);
      scroll-margin-top:var(--header-h);
    }
    .approach-intro { gap:6%; min-width:0; }
    .eyebrow { font-size:11px; margin:0 0 16px; }
    h2 { font-size:clamp(44px,3.6vw,58px); line-height:1.02; }
    .approach-description { margin:0; font-size:17px; line-height:1.5; }
    #approach-team { min-height:0; }
    .legal-link { margin:0; font-size:13px; justify-self:start; }
  }
  @media(max-width:800px) {
    .approach { padding:48px 18px; }
    .approach-intro { grid-template-columns:1fr; gap:14px; }
    h2 { font-size:clamp(26px,5vw,40px); line-height:1.06; }
    .approach-description { max-width:none; font-size:13px; line-height:1.65; margin:0; color:var(--muted); }
  }
  @media(max-width:600px) {
    .approach { padding:36px 14px; }
    .approach-intro { gap:12px; }
    .eyebrow { font-size:9px; margin-bottom:12px; }
    h2 { font-size:clamp(24px,6.5vw,36px); }
    .approach-description { font-size:12px; line-height:1.6; }
    .legal-link { margin-top:20px; font-size:12px; }
  }
</style>
