---
interface Props { count: number }
const { count } = Astro.props;
---
<div class="results-navigation reels-scroll-navigation" hidden="" data-reels-scroll-navigation=""><div class="results-navigation__position"><div class="results-navigation__track" aria-hidden="true"><span data-reels-scroll-progress=""></span></div><p class="results-navigation__counter" aria-live="polite" aria-atomic="true"><span data-reels-scroll-current="">01</span><span aria-hidden="true"> / </span><span class="visually-hidden"> из </span><span data-reels-scroll-total="">{String(count).padStart(2, '0')}</span></p></div><div class="results-navigation__arrows"><button class="home-icon-button" type="button" aria-label="Предыдущее видео" disabled="" data-reels-scroll-prev=""><span aria-hidden="true">←</span></button><button class="home-icon-button" type="button" aria-label="Следующее видео" data-reels-scroll-next=""><span aria-hidden="true">→</span></button></div></div>
<script>
  import { initReelsScroll } from '../../scripts/reels-scroll';
  initReelsScroll();
  document.addEventListener('astro:page-load', initReelsScroll);
</script>
<style>
.reels-scroll-navigation[hidden]{display:none}
.reels-scroll-navigation{display:flex;align-items:center;gap:24px;margin-top:24px}
.results-navigation__position{flex:1;min-width:0}
.results-navigation__track{height:2px;background:var(--line-gold);border-radius:var(--radius-pill);overflow:hidden}
.results-navigation__track span{display:block;width:100%;height:100%;background:var(--gold-deep);transform:scaleX(0);transform-origin:left}
.results-navigation__counter{margin:12px 0 0;color:var(--ink-2);font-size:.875rem;font-variant-numeric:tabular-nums}
.results-navigation__arrows{display:flex;gap:8px}
</style>
