---
import { Image } from 'astro:assets';
import { em } from '../../lib/markup';
import { getAboutContent } from '../../lib/specialistContent';
import { getHomeContent } from '../../lib/homeContent';

const [home, about] = await Promise.all([getHomeContent(), getAboutContent()]);
const { devices } = home;
---

<section class="home-section equipment" id="equipment" aria-labelledby="equipment-title" data-rail-root data-equipment-carousel>
  <div class="equipment__intro reveal">
    <p class="eyebrow">{devices.eyebrow}</p>
    <h2 id="equipment-title" set:html={em(devices.title)} />
    <p class="equipment__lead">{devices.lead}</p>
    <div class="slider-controls">
      <button class="home-icon-button" type="button" aria-label="Предыдущий аппарат" data-rail-prev>←</button>
      <button class="home-icon-button" type="button" aria-label="Следующий аппарат" data-rail-next>→</button>
    </div>
  </div>
  <div class="equipment__rail rail" data-rail tabindex="0" aria-label="Аппараты клиники">
    <div class="equipment__track" data-track>
    {
      devices.items.map((d) => {
        const Tag = d.href ? 'a' : 'article';
        return (
        <Tag class="machine-card" href={d.href} data-card>
          <div class="machine-card__photo">
          {d.image && <Image
            src={d.image.src}
            inferSize
            alt=""
            width={d.image.width}
            height={d.image.height}
            widths={[300, 500, 700]}
            sizes="(max-width: 600px) calc((100vw - 40px) * 0.82), (max-width: 800px) calc((100vw - 64px) * 0.64), 26vw"
            loading="lazy"
          />}
          {!d.image && <div class="machine-card__placeholder" aria-hidden="true">{d.name}</div>}
          </div>
          <div class="machine-card__body">
          <h3>{d.name}</h3>
          <p>{d.short}</p>
          {d.href && <><span class="machine-card__arrow" aria-hidden="true">→</span><span class="machine-card__more home-text-link">{about.details_label} <span aria-hidden="true">→</span></span></>}
          </div>
        </Tag>
      );})
    }
  </div>
  </div>
  <p class="visually-hidden" data-equipment-status aria-live="polite"></p>
  <div class="equipment__mobile-actions">
    {devices.all_label && <a class="equipment__all button button--outline" href="/apparaty">{devices.all_label}<span aria-hidden="true">→</span></a>}
    {devices.consultation_title && devices.consultation_label && <div class="equipment__consultation">
      <h3>{devices.consultation_title}</h3>
      <button class="home-text-link" type="button" data-open-sheet>{devices.consultation_label} <span aria-hidden="true">→</span></button>
    </div>}
  </div>
</section>

<script>
  import { initEquipmentCarousels } from '../../scripts/equipment-carousel';
  initEquipmentCarousels();
</script>

<style>
  .equipment { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 32px 48px; }
  .equipment { scroll-margin-top: calc(var(--header-h-sticky) + 24px); }
  .equipment__track { display: contents; }
  .machine-card__photo { overflow: hidden; flex-shrink: 0; }
  .machine-card .machine-card__more { display: none; }
  .equipment__intro { min-width: 0; }
  .equipment__lead { color: var(--ink-2); font-size: 1rem; line-height: 1.6; margin: 16px 0 24px; }
  .slider-controls { display: flex; gap: 8px; }
  .equipment__rail { min-width: 0; gap: 24px; }
  .machine-card { scroll-snap-align: start; flex: 0 0 46%; min-width: 0; display: flex; flex-direction: column; overflow: hidden; border-radius: var(--radius-lg); background: var(--sand); }
  .machine-card:nth-child(2n) { background: var(--home-surface-cool); }
  /* Linked cards answer the press itself; articles without a link stay still. */
  a.machine-card { transition: transform var(--dur-press) var(--ease-out); }
  a.machine-card:active { transform: scale(0.985); }
  .machine-card :global(img) { width: 100%; height: clamp(240px, 25vw, 340px); padding: 20px; object-fit: contain; mix-blend-mode: multiply; transition: transform var(--dur-slow) var(--ease-out); }
  /* Same hover zoom as the home service cards (Categories.astro). */
  @media (hover: hover) and (pointer: fine) {
    .machine-card:hover :global(img) { transform: scale(1.03); }
  }
  @media (prefers-reduced-motion: reduce) {
    .machine-card:hover :global(img), a.machine-card:active { transform: none; }
  }
  .machine-card__placeholder { height: 280px; display: grid; place-items: center; font: 1.5rem var(--display); }
  .machine-card__body { flex: 1; display: flex; flex-direction: column; padding: 20px; }
  .machine-card h3 { font: 400 var(--home-card-title)/1.12 var(--display); margin: 0 0 8px; }
  .machine-card p { color: var(--ink-2); font-size: 0.875rem; line-height: 1.5; margin: 0 0 20px; }
  .machine-card__arrow { display: grid; place-items: center; align-self: flex-end; width: 48px; height: 48px; margin-top: auto; background: var(--gold-deep); color: white; border-radius: 50%; font-size: 1.5rem; }
  .machine-card:hover .machine-card__arrow { background: var(--gold-hover); }
  .equipment__mobile-actions { grid-column: 2; display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .equipment__consultation { flex: 1 1 260px; }
  .equipment__consultation h3 { font: 400 1.5rem/1.2 var(--display); margin: 0 0 4px; }
  @media (min-width: 801px) and (max-width: 1100px) {
    .equipment { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 32px; }
    .machine-card { flex-basis: 78%; }
  }
  @media (max-width: 800px) {
    .equipment { display: block; }
    .equipment__intro { margin-bottom: 24px; }
    .equipment__lead { margin-bottom: 24px; }
    .slider-controls { justify-content: flex-end; }
    .equipment__rail { display: block; overscroll-behavior-x: contain; scroll-behavior: auto; }
    .equipment__track { display: flex; gap: 16px; }
    .equipment[data-interactive] .equipment__rail { overflow-x: hidden; scroll-snap-type: none; touch-action: pan-y; }
    .equipment[data-interactive] .equipment__track { will-change: transform; }
    .machine-card, .machine-card:nth-child(2n) { flex: 0 0 64%; height: var(--equipment-card-height, auto); background: transparent; border-radius: 0; scroll-snap-align: start; }
    a.machine-card:active { transform: none; }
    .machine-card__photo { border-radius: 22px; background: var(--equipment-photo-bg); }
    .machine-card :global(img) { height: auto; aspect-ratio: 3 / 4; padding: 16px; mix-blend-mode: normal; }
    .machine-card__body { min-height: 0; padding: 16px 0 0; align-items: flex-start; }
    .machine-card h3 { flex-shrink: 0; font-size: 1.5rem; line-height: 1.2; }
    .machine-card p { flex-shrink: 0; margin-bottom: 0; }
    .machine-card__arrow { display: none; }
    .machine-card .machine-card__more { display: inline-flex; height: 44px; min-height: 21px; padding-block: 0; margin-top: auto; }
    .machine-card:focus-visible { outline: 2px solid var(--gold-deep); outline-offset: -3px; }
    .equipment__mobile-actions { display: grid; margin-top: 28px; gap: 24px; }
    .equipment__all { width: 100%; }
    .equipment__consultation { padding: 20px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); }
  }
  @media (max-width: 600px) {
    .machine-card, .machine-card:nth-child(2n) { flex-basis: 82%; }
    .machine-card :global(img) { height: 280px; aspect-ratio: auto; padding: 12px; }
  }
</style>
