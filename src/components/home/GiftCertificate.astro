---
import { getHomeContent } from '../../lib/homeContent';
import { em } from '../../lib/markup';
const { giftCertificate: gift } = await getHomeContent();
const enabled = gift.title && gift.video_url && gift.poster_url;
---
{enabled && (
  <section class="home-section gift" id="gift-certificate" aria-labelledby="gift-title" data-gift-certificate>
    <div class="gift__inner">
      <p class="eyebrow">{gift.eyebrow}</p>
      <h2 id="gift-title" set:html={em(gift.title)} />
      <div class="gift__film">
        <video muted playsinline loop preload="none" width="720" height="1280"
          data-src={gift.video_url} data-poster={gift.poster_url} aria-label={gift.video_label} />
        <button class="gift__play" type="button" aria-label={gift.play_label}
          data-play-label={gift.play_label} data-pause-label={gift.pause_label}>
          <svg class="gift__play-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 4v16l13-8z" /></svg>
          <svg class="gift__pause-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zm8 0h4v16h-4z" /></svg>
        </button>
        <noscript><img src={gift.poster_url} width="720" height="1280" alt={gift.video_label} loading="lazy" /></noscript>
      </div>
      <p class="gift__lead">{gift.lead}</p>
      <button class="button gift__cta" type="button" data-open-sheet data-context={gift.context}>
        {gift.button_label}<span aria-hidden="true">↗</span>
      </button>
    </div>
  </section>
)}
<script>import '../../scripts/gift-certificate';</script>
<style>
  .gift { display: none; background: var(--paper); }
  .gift__inner { max-width: 420px; margin-inline: auto; text-align: center; }
  .gift h2 { margin-bottom: 28px; }
  .gift h2 :global(em) { color: var(--gold-deep); font-style: italic; }
  .gift__film { position: relative; aspect-ratio: 9 / 16; overflow: hidden; border-radius: var(--home-image-radius); background: var(--ivory); }
  .gift__film video, .gift__film img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .gift__film noscript img { position: absolute; inset: 0; }
  .gift__play { position: absolute; bottom: 14px; right: 14px; display: none; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; color: var(--ink); background: var(--paper); cursor: pointer; }
  .gift[data-ready] .gift__play { display: grid; }
  .gift__pause-icon, .gift[data-playing] .gift__play-icon { display: none; }
  .gift[data-playing] .gift__pause-icon { display: block; }
  .gift__lead { margin: 24px 0 20px; color: var(--ink-2); font-size: 0.9375rem; line-height: 1.65; text-wrap: pretty; }
  .gift__cta { width: 100%; justify-content: center; }
  @media (max-width: 800px) { .gift { display: block; } }
</style>
