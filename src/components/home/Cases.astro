---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import { getHomeContent } from '../../lib/homeContent';

const home = await getHomeContent();
const { cases } = home;
---

<section class="section results" id="results">
  <SectionHeading eyebrow={cases.eyebrow} title={cases.title} lead={cases.lead} />

  <div class="results-grid rail">
    {
      cases.items.map((c, i) => (
        <article class:list={['result-card', 'reveal', { 'result-card--large': i === 0 }]}>
          <div class="result-card__image">
            <Image
              src={c.image.src}
              alt={c.alt}
              width={i === 0 ? 850 : 700}
              height={i === 0 ? 780 : 620}
              widths={[480, 700, 1000]}
              sizes={i === 0 ? '(max-width: 800px) 86vw, 50vw' : '(max-width: 800px) 86vw, 22vw'}
              loading="lazy"
            />
            <span class="glass-panel">до / после</span>
          </div>
          <div>
            <p>{c.category}</p>
            <h3>{c.title}</h3>
            <span>{c.result}</span>
          </div>
        </article>
      ))
    }
  </div>
  <a class="button button--outline" href="/result">{cases.all_label} <span>↗</span></a>
</section>

<style>
  .results {
    border-top: 1px solid var(--line);
  }
  .results-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 18px;
    overflow: visible;
  }
  .result-card {
    display: grid;
    grid-template-columns: 51% 49%;
    min-height: 360px;
    background: var(--paper);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    transition: box-shadow var(--dur-fast), transform var(--dur-fast);
  }
  .result-card:hover {
    box-shadow: var(--shadow-glow);
  }
  .result-card--large {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    min-height: 740px;
  }
  .result-card__image {
    position: relative;
    overflow: hidden;
    min-height: 260px;
  }
  .result-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }
  .result-card:hover .result-card__image :global(img) {
    transform: scale(1.025);
  }
  .result-card__image > span {
    /* case photos can carry their own baked-in caption text near this corner —
       stay close to opaque so the tag never has to compete with it for legibility */
    --glass-bg: rgba(255, 253, 246, 0.92);
    position: absolute;
    z-index: 1;
    left: 16px;
    bottom: 16px;
    border-radius: var(--radius-pill);
    padding: 8px 15px;
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .result-card > div:last-child {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 34px;
  }
  .result-card--large .result-card__image {
    flex: 1;
  }
  .result-card--large > div:last-child {
    min-height: 180px;
  }
  .result-card > div:last-child > p {
    margin: 0 0 13px;
    color: var(--gold-deep);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .result-card h3 {
    font: 400 28px var(--display);
    margin: 0 0 14px;
  }
  .result-card > div:last-child > span {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }
  .results > .button {
    margin-top: 34px;
  }

  @media (max-width: 1100px) {
    .result-card {
      grid-template-columns: 1fr;
    }
    .result-card__image {
      min-height: 230px;
    }
  }
  @media (max-width: 800px) {
    .results-grid {
      display: flex;
      overflow-x: auto;
      gap: 10px;
      margin-right: -18px;
      padding-right: 18px;
    }
    .result-card,
    .result-card--large {
      flex: 0 0 86vw;
      display: flex;
      flex-direction: column;
      min-height: 560px;
      scroll-snap-align: center;
    }
    .result-card__image,
    .result-card--large .result-card__image {
      height: 380px;
      flex: 0 0 380px;
    }
    .result-card > div:last-child,
    .result-card--large > div:last-child {
      min-height: 180px;
      padding: 25px;
    }
    .results > .button {
      width: 100%;
    }
  }
</style>
