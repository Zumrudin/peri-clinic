---
import { Image, getImage } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import { getHomeContent } from '../../lib/homeContent';

const home = await getHomeContent();
const { cases } = home;
const items = cases.items.flatMap(c => c.image ? [{ ...c, image: c.image }] : []);
const mobileCount = Math.min(items.length, 10);
// Responsive sources preserve the full before/after composition.
const mobileImages = await Promise.all(items.slice(0, 10).map(async (c) => {
  const images = await Promise.all([480, 700, 1000].map(width => getImage({
    src: c.image.src,
    width,
    height: Math.round(width * c.image.height / c.image.width),
    format: 'webp',
  })));
  return images.map((image, i) => `${image.src} ${[480, 700, 1000][i]}w`).join(', ');
}));
---

<section class="home-section section results" id="results" data-results-carousel data-results-desktop aria-labelledby="results-title">
  <SectionHeading home layout="block" id="results-title" eyebrow={cases.eyebrow} title={cases.title} lead={cases.lead} />

  <div class="results-grid rail" id="home-results-rail" data-results-rail role="group" aria-label="Работы до и после">
    {
      items.map((c, i) => (
        <article class:list={['result-card', 'reveal', { 'result-card--large': i === 0 }]}>
          <div class="result-card__image">
            <picture>
            {mobileImages[i] && <source media="(max-width: 800px)" type="image/webp" srcset={mobileImages[i]} sizes="(max-width: 400px) 70vw, 280px" width={c.image.width} height={c.image.height} />}
            <Image
              src={c.image.src}
              alt={c.alt}
              width={c.image.width}
              height={c.image.height}
              widths={[480, 700, 1000]}
              sizes="(max-width: 400px) 70vw, (max-width: 800px) 280px, (max-width: 1100px) 40vw, 400px"
              loading="lazy"
            />
            </picture>
            <span class="glass-panel">до / после</span>
          </div>
          <div>
            <p>{c.category}</p>
            <h3>{c.title}</h3>
            <span>{c.result}</span>
          </div>
        </article>
      ))
    }
  </div>
  {mobileCount > 1 && <div class="results-navigation" data-results-navigation hidden>
    <div class="results-navigation__position">
      <div class="results-navigation__track" aria-hidden="true"><span data-results-progress /></div>
      <p class="results-navigation__counter" aria-live="polite" aria-atomic="true"><span data-results-current>01</span><span aria-hidden="true"> / </span><span class="visually-hidden"> из </span><span data-results-total>{String(mobileCount).padStart(2, '0')}</span></p>
    </div>
    <div class="results-navigation__arrows">
      <button class="home-icon-button" type="button" data-results-prev aria-label="Предыдущая работа" aria-controls="home-results-rail" disabled><span aria-hidden="true">←</span></button>
      <button class="home-icon-button" type="button" data-results-next aria-label="Следующая работа" aria-controls="home-results-rail"><span aria-hidden="true">→</span></button>
    </div>
  </div>}
  <a class="button button--outline" href="/result">{cases.all_label} <span aria-hidden="true">→</span></a>
</section>

<script>
  import { initResultsCarousel } from '../../scripts/results-carousel';
  // Module scripts run once under ClientRouter; the init is idempotent (data-results-ready).
  document.addEventListener('astro:page-load', initResultsCarousel);
</script>

<style>
  .results { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); grid-template-rows: auto auto 1fr auto; gap: 24px 48px; background: var(--paper); }
  .results > :global(.section-heading) { grid-column: 1; grid-row: 1; margin: 0; }
  .results-grid { --desktop-card-width: 46%; grid-column: 2; grid-row: 1 / 4; display: flex; min-width: 0; gap: 24px; overflow-x: auto; overscroll-behavior-x: contain; }
  .results-grid::after { content: ''; flex: 0 0 calc(100% - var(--desktop-card-width) - 24px); }
  .result-card { flex: 0 0 var(--desktop-card-width); display: flex; flex-direction: column; min-width: 0; padding: 12px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--ivory); opacity: 1; transform: none; }
  .result-card__image { flex: none; aspect-ratio: 1; overflow: hidden; border-radius: var(--radius); }
  .result-card__image picture { display: contents; }
  .result-card__image :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .result-card__image > span { display: none; }
  .result-card > div:last-child { flex: 1; padding: 20px 8px 8px; }
  .result-card > div:last-child > p { margin: 0 0 8px; color: var(--gold-deep); font-size: 14px; line-height: 1.5; }
  .result-card h3 { font: 400 var(--home-card-title)/1.12 var(--display); margin: 0 0 8px; }
  .result-card > div:last-child > span { color: var(--ink-2); font-size: 15px; line-height: 1.5; }
  .results-navigation[hidden] { display: none; }
  .results-navigation:not([hidden]) { display: contents; }
  .results-navigation__arrows { grid-column: 1; grid-row: 2; display: flex; gap: 8px; }
  .results-navigation__position { grid-column: 2; grid-row: 4; min-width: 0; }
  .results-navigation__track { height: 2px; background: var(--line-gold); border-radius: var(--radius-pill); overflow: hidden; }
  .results-navigation__track span { display: block; width: 100%; height: 100%; background: var(--gold-deep); transform: scaleX(0); transform-origin: left; transition: transform var(--dur-fast); }
  .results-navigation__counter { margin: 12px 0 0; color: var(--ink-2); font-size: 14px; font-variant-numeric: tabular-nums; }
  .results > .button { grid-column: 1; grid-row: 3; justify-self: start; align-self: start; }
  .results-grid:focus-visible { outline: 2px solid var(--gold-deep); outline-offset: -3px; }
  @media (min-width: 801px) and (max-width: 1100px) {
    .results { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 24px 32px; }
    .results-grid { --desktop-card-width: 78%; }
  }
  @media (max-width: 800px) {
    .results { display: block; --results-card-width: min(82vw, 360px); }
    .results > :global(.section-heading) { margin-bottom: 32px; }
    .results-grid { gap: 16px; margin-right: calc(-1 * var(--gutter)); padding-right: var(--gutter); }
    .results-grid::after { flex-basis: max(0px, calc(100vw - 2 * var(--gutter) - var(--results-card-width) - 16px)); }
    .result-card { flex-basis: var(--results-card-width); scroll-snap-stop: always; }
    .result-card:nth-child(n+11) { display: none; }
    .result-card > div:last-child { padding: 16px 4px 8px; }
    .results-navigation:not([hidden]) { display: flex; align-items: center; gap: 24px; margin-top: 24px; }
    .results-navigation__position { flex: 1; }
    .results > .button { width: 100%; margin-top: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .results-grid { scroll-behavior: auto; }
    .results-navigation__track span { transition: none; }
  }
</style>
