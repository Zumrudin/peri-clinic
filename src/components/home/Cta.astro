---
import { Image } from 'astro:assets';
import { em, telHref, whatsappHref } from '../../lib/markup';
import { getSiteSettings } from '../../lib/siteContent';
import { getHomeContent } from '../../lib/homeContent';

const site = await getSiteSettings();
const home = await getHomeContent();
const { cta } = home;
const quick = [
  { label: 'Позвонить', href: telHref(site.phone), external: false },
  site.telegram_url && { label: 'Telegram', href: site.telegram_url, external: true },
  { label: 'WhatsApp', href: whatsappHref(site.phone, site.whatsapp_text), external: true },
  site.max_url && { label: 'MAX', href: site.max_url, external: true },
].filter(Boolean) as Array<{ label: string; href: string; external: boolean }>;
---

<section class="home-section booking" id="booking" aria-labelledby="booking-title">

  <div class="booking__image reveal">
    <Image
      src={cta.image.src}
      alt={cta.image_alt}
      width={900}
      height={1100}
      widths={[480, 900]}
      sizes="(max-width: 800px) 100vw, 40vw"
      loading="lazy"
    />
  </div>
  <div class="booking__content reveal">
    <p class="eyebrow">{cta.eyebrow}</p>
    <h2 id="booking-title" set:html={em(cta.title)} />
    <p class="booking__lead">{cta.lead}</p>
    <button class="button" type="button" data-open-sheet>{cta.button_label} <span>↗</span></button>
    <ul class="booking__quick">
      {
        quick.map((q) => (
          <li>
            <a href={q.href} target={q.external ? '_blank' : undefined} rel={q.external ? 'noopener' : undefined}>
              {q.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="booking__hours">{site.hours} · {site.address_short}</p>
  </div>
</section>

<style>
  .booking { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .booking__image { position: relative; min-height: 520px; overflow: hidden; border-radius: var(--radius-lg) 0 0 var(--radius-lg); }
  .booking__image :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(.75); }
  .booking__content { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; min-width: 0; padding: clamp(32px, 4vw, 64px); background: var(--sand); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; }
  .booking__content h2 :global(em) { color: var(--gold-deep); font-style: italic; }
  .booking__lead { color: var(--ink-2); font-size: 1rem; line-height: 1.6; margin: 24px 0; max-width: 60ch; }
  .booking__quick { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .booking__quick a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 0.875rem; font-weight: 500; color: var(--gold-deep); }
  .booking__quick a:hover { border-color: var(--gold-deep); }
  .booking__hours { margin: 24px 0 0; color: var(--ink-2); font-size: 0.875rem; line-height: 1.6; }
  @media (max-width: 1000px) { .booking { grid-template-columns: minmax(0, 1fr); } .booking__image { min-height: 0; height: 300px; border-radius: var(--radius-lg) var(--radius-lg) 0 0; } .booking__content { border-radius: 0 0 var(--radius-lg) var(--radius-lg); } }
  @media (max-width: 600px) { .booking__image { height: 240px; } .booking__content { padding: 24px; } .booking__content .button { width: 100%; } }
</style>
