---
import { getHomeReels } from '../../lib/homeReelContent';
interface Props {
  content: { reels_title?: string | null; reels_description?: string | null; reels_hint?: string | null };
}
const { content } = Astro.props;
const items = await getHomeReels();
---
{items.length > 0 && content.reels_title && <section class="reels" data-home-reels aria-labelledby="reels-title">
  <header class="reels-heading">
    <h2 id="reels-title">{content.reels_title}</h2>
    {content.reels_description && <p>{content.reels_description}</p>}
  </header>
  <div class="reels-rail" data-reels-rail tabindex="0" aria-label={content.reels_title}>
    {items.map((item, index) => <article class="reel" data-reel aria-labelledby={`reel-title-${index}`}>
      <video data-reel-video data-src={item.video_url} data-hls={item.hls_url} data-poster={item.image_url} muted playsinline preload="none" aria-labelledby={`reel-title-${index}`}>
      </video>
      <button type="button" class="reel-caption-toggle" data-reel-caption-toggle aria-label="Скрыть подпись" aria-expanded="true" aria-controls={`reel-caption-${index}`}></button>
      <div class="reel-overlay">
        <div class="reel-caption" id={`reel-caption-${index}`}>
          <h3 id={`reel-title-${index}`}>{item.title}</h3>
          {item.author && <p class="reel-author">{item.author}</p>}
        </div>
        <div class="reel-controls" data-reel-controls hidden>
          <button type="button" data-reel-toggle aria-label="Воспроизвести видео">
            <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 4 12 8-12 8Z" /></svg>
            <svg class="pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z" /></svg>
          </button>
          <div class="reel-progress" aria-hidden="true"><span data-reel-progress></span></div>
          <button type="button" data-reel-mute aria-label="Включить звук" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9h4l5-4v14l-5-4H3z" /><path class="sound-on" d="M16 8q5 4 0 8" /><path class="sound-off" d="m16 9 5 6m0-6-5 6" /></svg>
          </button>
        </div>
        <p class="reel-error" data-reel-error role="status" hidden>Не удалось загрузить видео. <a href={item.video_url}>Открыть отдельно</a></p>
        <noscript><a class="reel-fallback" href={item.video_url}>Смотреть видео</a></noscript>
      </div>
    </article>)}
  </div>
  {items.length > 1 && <div class="reels-navigation" data-reels-navigation hidden>
    <div class="reels-dots" aria-label="Выбор видео">{items.map((item, index) => <button type="button" data-reels-dot aria-label={`Видео ${index + 1}: ${item.title}`} aria-current={index === 0 ? 'true' : undefined}><span></span></button>)}</div>
    {content.reels_hint && <p>{content.reels_hint}</p>}
  </div>}
</section>}
<script>
  import { initHomeReels } from '../../scripts/home-reels';
  initHomeReels();
  document.addEventListener('astro:page-load', initHomeReels);
</script>
<style>
  .reels { display: none; }
  @media (max-width: 800px) {
    .reels { display: block; margin-top: 48px; }
    .reels-heading { margin-bottom: 24px; }
    .reels-heading h2 { margin: 0 0 12px; }
    .reels-heading p { margin: 0; color: var(--ink-2); font-size: .9375rem; line-height: 1.5; }
    .reels-rail { display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; margin-right: calc(-1 * var(--home-gutter)); padding-right: var(--home-gutter); }
    .reels-rail::after { content: ''; flex: 0 0 var(--reels-tail, 20px); }
    .reels-rail::-webkit-scrollbar { display: none; }
    .reel { position: relative; flex: 0 0 min(calc(100% - 44px), 360px); aspect-ratio: 9 / 16; overflow: hidden; border-radius: 18px; background: var(--sand); scroll-snap-align: start; scroll-snap-stop: always; isolation: isolate; }
    video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .reel-overlay { position: absolute; inset: auto 0 0; padding: 0 16px 10px; color: white; background: rgba(0,0,0,.78); }
    .reel-caption { position: absolute; inset: auto 0 100%; padding: 64px 16px 0; background: linear-gradient(transparent,rgba(0,0,0,.72) 45%,rgba(0,0,0,.78)); pointer-events: none; transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out); }
    .reel[data-caption-hidden] .reel-caption { transform: translateY(100%); opacity: 0; }
    .reel .reel-caption-toggle { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border-radius: inherit; }
    .reel h3 { margin: 0 0 8px; font: 400 clamp(1.375rem, 6vw, 1.875rem)/1.12 var(--display); overflow-wrap: anywhere; }
    .reel-author { font-size: .75rem; line-height: 1.45; margin: 0 0 6px; }
    .reel-controls { position: relative; display: flex; align-items: center; gap: 8px; }
    .reel button { display: grid; place-items: center; flex: 0 0 44px; width: 44px; height: 44px; padding: 10px; border: 0; background: transparent; color: white; cursor: pointer; }
    .reel button svg { width: 24px; height: 24px; fill: currentColor; }
    .sound-on, .sound-off { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
    .pause-icon, .sound-on { display: none; }
    .reel[data-playing] .pause-icon, .reel[data-sound] .sound-on { display: block; }
    .reel[data-playing] .play-icon, .reel[data-sound] .sound-off { display: none; }
    .reel-progress { height: 3px; flex: 1; overflow: hidden; background: rgba(255,255,255,.35); border-radius: 3px; }
    .reel-progress span { display: block; height: 100%; background: var(--gold-light); transform: scaleX(0); transform-origin: left; }
    .reels-navigation { text-align: center; }
    .reels-dots { display: flex; flex-wrap: wrap; justify-content: center; margin-top: 12px; }
    .reels-dots button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; background: none; border: 0; cursor: pointer; }
    .reels-dots span { width: 8px; height: 8px; background: var(--muted); opacity: .4; border-radius: 8px; transition: transform var(--dur-press) var(--ease-out), opacity var(--dur-press) var(--ease-out); }
    .reels-dots [aria-current] span { background: var(--gold-deep); opacity: 1; transform: scaleX(2.5); }
    .reels-navigation p { margin: 0; font-size: .8125rem; color: var(--ink-2); }
    .reel-error { font-size: .8125rem; line-height: 1.5; }
    .reel-error a, .reel-fallback { color: white; text-decoration: underline; }
    .reel button:focus-visible { outline: 2px solid white; outline-offset: -2px; border-radius: 8px; }
    .reels-rail:focus-visible, .reels-dots button:focus-visible { outline: 2px solid var(--gold-deep); outline-offset: -2px; }
    [hidden] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .reels-dots span { transition: none; } .reel-caption { transition-property: opacity; } .reel[data-caption-hidden] .reel-caption { transform: none; } }
</style>
