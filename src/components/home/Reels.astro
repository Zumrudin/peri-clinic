---
import { getHomeReels } from '../../lib/homeReelContent';
import Reels from '../gallery/Reels.astro';
interface Props {
  content: { reels_title?: string | null; reels_description?: string | null; reels_hint?: string | null };
}
const { content } = Astro.props;
const items = await getHomeReels();
---
<Reels items={items} content={content} mobileOnly />
