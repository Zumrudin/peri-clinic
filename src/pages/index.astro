---
import Page from '../layouts/Page.astro';
import Hero from '../components/home/Hero.astro';
import Ticker from '../components/home/Ticker.astro';
import Categories from '../components/home/Categories.astro';
import Approach from '../components/home/Approach.astro';
import Devices from '../components/home/Devices.astro';
import Cases from '../components/home/Cases.astro';
import Reviews from '../components/home/Reviews.astro';
import Cta from '../components/home/Cta.astro';
import { getHomeContent } from '../lib/homeContent';

const home = await getHomeContent();
---

<Page title={home.seo.title} description={home.seo.description}>
  <div id="home-page">
  <Hero />
  <Ticker items={home.ticker} />
  <Categories />
  <Approach />
  <Devices />
  <Cases />
  <Reviews />
  <Cta />
  </div>
</Page>


<style>
  /* Homepage editorial hierarchy; other templates retain their own typography. */
  #home-page :global(#services h2 em),
  #home-page :global(#approach h2 em),
  #home-page :global(#equipment-title em),
  #home-page :global(#results h2 em) {
    font-style: normal;
    color: inherit;
  }
  #home-page :global(.reviews .glow) { opacity: 0.12; }
  #home-page :global(.portraits .person-caption h4) { font-size: 24px; line-height: 1.2; }
  #home-page :global(.portraits .person-caption p) { font-size: 15px; line-height: 1.5; color: var(--ink-2); }
  #home-page :global(.portraits .person-more) { font-size: 14px; min-height: 44px; }
  #home-page :global(.person-expertise) { margin: 14px 0; padding-top: 12px; border-top: 1px solid var(--line); }
  #home-page :global(.person-expertise strong) { display: block; margin-bottom: 8px; font: 500 15px/1.45 var(--sans); color: var(--ink); }
  #home-page :global(.result-card > div:last-child > p) { font-size: 14px; line-height: 1.45; letter-spacing: normal; text-transform: none; }
  #home-page :global(.result-card > div:last-child > span) { font-size: 15px; line-height: 1.5; color: var(--ink-2); }
  @media (max-width: 800px) {
    #home-page :global(#services) { padding-top: 40px; padding-bottom: 40px; }
    #home-page :global(.equipment) { padding-top: 40px; padding-bottom: 40px; }
    #home-page :global(.reviews) { padding-top: 44px; padding-bottom: 44px; }
    #home-page :global(.reviews .rating) { margin: 20px 0 24px; }
    #home-page :global(.booking) { padding-top: 40px; padding-bottom: 40px; }
    #home-page :global(.booking__image) { min-height: 0; height: 240px; }
    #home-page :global(.booking__content) { padding: 28px 22px; }
    #home-page :global(.portraits .gallery-card) { flex-basis: 76%; }
    #home-page :global(.portraits .gallery-rail) { gap: 14px; }
    #home-page :global(.portraits .gallery-photo img) { height: 230px; aspect-ratio: auto; object-fit: contain; }
    #home-page :global(.portraits .person-caption h4) { font-size: 23px; overflow-wrap: normal; }
    #home-page :global(.result-card h3) { font-size: 25px; }
    #home-page :global(.results) { --results-card-width: min(76vw, 290px, 34svh); }
  }
</style>
