---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import { getAllDevices } from '../lib/deviceContent';
import { getHomeContent } from '../lib/homeContent';

const [items, home] = await Promise.all([getAllDevices(), getHomeContent()]);
const copy = home.devices;
---
<Page title={copy.catalog_seo_title || copy.catalog_title} description={copy.catalog_seo_description}>
  <section class="catalog" aria-labelledby="catalog-title">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 id="catalog-title">{copy.catalog_title}</h1>
    <div class="catalog__grid">
      {items.map((item) => {
        const Tag = item.href ? 'a' : 'article';
        return <Tag class="catalog__card" href={item.href}>
          <div class="catalog__image">
            {item.image ? <Image src={item.image.src} alt="" width={item.image.width} height={item.image.height} widths={[240,480,720]} sizes="(max-width: 800px) 44vw, 28vw" loading="lazy" /> : <span class="catalog__placeholder" aria-hidden="true">{item.name}</span>}
          </div>
          <div class="catalog__body">
            <h2>{item.name}</h2><p>{item.short}</p>
            {item.href && <span class="catalog__arrow" aria-hidden="true">→</span>}
          </div>
        </Tag>;
      })}
    </div>
    {copy.consultation_title && copy.consultation_label && <div class="catalog__consultation">
      <h2>{copy.consultation_title}</h2>
      <button class="button" type="button" data-open-sheet>{copy.consultation_label} <span aria-hidden="true">→</span></button>
    </div>}
  </section>
</Page>
<style>
  .catalog { max-width: var(--container); margin: auto; padding: 64px var(--gutter); }
  h1 { font: 400 clamp(36px,5vw,64px)/1.1 var(--display); margin: 0 0 32px; }
  .catalog__grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; }
  .catalog__card { min-width: 0; overflow: hidden; border-radius: 22px; background: #eee7dd; display: flex; flex-direction: column; }
  .catalog__card:nth-child(4n+2), .catalog__card:nth-child(4n+3) { background: #e4e5d9; }
  .catalog__image { height: 260px; display: grid; place-items: center; padding: 20px; }
  .catalog__image :global(img) { width: 100%; height: 100%; object-fit: contain; min-height: 0; mix-blend-mode: multiply; }
  .catalog__placeholder { font: 400 28px var(--display); color: var(--ink-2); }
  .catalog__body { display: flex; flex: 1; flex-direction: column; padding: 20px; background: rgba(255,255,255,.16); }
  .catalog__body h2 { font: 400 30px/1.1 var(--display); margin: 0 0 8px; overflow-wrap: anywhere; }
  .catalog__body p { font-size: 15px; line-height: 1.4; color: var(--ink-2); margin: 0; overflow-wrap: anywhere; }
  .catalog__arrow { align-self: flex-end; display: grid; place-items: center; width: 40px; height: 40px; margin-top: 14px; border-radius: 50%; background: var(--gold-deep); color: white; font-size: 24px; }
  .catalog__consultation { padding: 24px; margin-top: 24px; border-radius: 22px; background: var(--sand); }
  .catalog__consultation h2 { font: 400 30px/1.1 var(--display); margin-bottom: 16px; }
  @media(max-width:800px) {
    .catalog { padding: 36px 18px; }
    .catalog__grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; }
    .catalog__image { height: clamp(145px,42vw,220px); padding: 6px; }
    .catalog__body { padding: 12px; }
    .catalog__body h2 { font-size: clamp(20px,5.7vw,24px); }
    .catalog__body p { font-size: 14px; }
    .catalog__consultation .button { white-space: normal; }
  }
</style>
