---
import Page from '../layouts/Page.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { em, telHref, whatsappHref } from '../lib/markup';
import { getSiteSettings } from '../lib/siteContent';

const site = await getSiteSettings();
const telegramAddress = site.telegram_url ? new URL(site.telegram_url).pathname.replace(/^\/+/, '') : '';

const links = [
  { label: 'Позвонить', value: site.phone, href: telHref(site.phone) },
  site.email && { label: 'Написать на почту', value: site.email, href: `mailto:${site.email}` },
  site.telegram_url && { label: 'Telegram', value: telegramAddress.startsWith('+') ? telegramAddress : `@${telegramAddress}`, href: site.telegram_url },
  { label: 'WhatsApp', value: 'Написать в чат', href: whatsappHref(site.phone, site.whatsapp_text) },
  site.max_url && { label: 'MAX', value: 'Написать в мессенджер', href: site.max_url },
].filter(Boolean) as Array<{ label: string; value: string; href: string }>;
---

<Page title={`Контакты PERI CLINIC у метро ${site.nearest_metro || 'Домодедовская'} — адрес и маршрут`} description={`PERI CLINIC — ${site.address_short}. ${site.nearest_metro ? `Метро ${site.nearest_metro}${site.metro_walk_time ? `, ${site.metro_walk_time}` : ''}. ` : ''}${site.hours}. Телефон ${site.phone}.`}>
  <Breadcrumbs slot="head" items={[{ name: 'Контакты', href: '/kontakty' }]} />

  <section class="contacts reveal">
    <div class="contacts__intro">
      <p class="eyebrow">Контакты</p>
      <h1>Контакты<br /><em>PERI CLINIC</em></h1>
      <p class="contacts__address" set:html={em(site.address_lines || site.address_short)} />
      {site.nearest_metro && (
        <div class="contacts__metro">
          <span class="contacts__metro-mark" aria-hidden="true">М</span>
          <p>
            <strong>Метро {site.nearest_metro}</strong>
            {site.metro_walk_time && <span>{site.metro_walk_time}</span>}
          </p>
        </div>
      )}
      {site.metro_directions && <p class="contacts__directions">{site.metro_directions}</p>}
      <p class="contacts__hours">{site.hours}</p>
      {site.map_link && (
        <a class="text-link" href={site.map_link} target="_blank" rel="noopener">
          Открыть на карте <span>↗</span>
        </a>
      )}
    </div>

    <ul class="contacts__list">
      {
        links.map((l) => (
          <li>
            <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>
              <span class="contacts__label">{l.label}</span>
              <span class="contacts__value">
                {l.value} <i aria-hidden="true">↗</i>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    site.map_embed_src && (
      <section class="contacts-map" data-map-embed data-src={site.map_embed_src}>
        <button class="contacts-map__trigger" type="button" data-map-trigger>
          Показать карту <span aria-hidden="true">↗</span>
        </button>
      </section>
    )
  }
</Page>

{
  site.map_embed_src && (
    <script>
      document.querySelectorAll<HTMLElement>('[data-map-embed]').forEach((el) => {
        el.querySelector('[data-map-trigger]')?.addEventListener('click', () => {
          const iframe = document.createElement('iframe');
          iframe.src = el.dataset.src!;
          iframe.title = 'PERI CLINIC — карта проезда';
          iframe.loading = 'lazy';
          el.replaceChildren(iframe);
        });
      });
    </script>
  )
}

<style>
  .contacts {
    max-width: var(--container);
    margin: auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 6vw;
    padding: 60px var(--gutter) var(--section);
  }
  .contacts__intro h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.98;
    margin: 0 0 32px;
  }
  .contacts__intro h1 em {
    color: var(--gold);
    font-style: italic;
  }
  .contacts__address {
    font: 1.25rem/1.4 var(--display);
    margin: 0 0 12px;
  }
  .contacts__hours {
    color: var(--muted);
    font-size: 0.875rem;
    margin: 0 0 28px;
  }
  .contacts__metro {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 22px 0 12px;
  }
  .contacts__metro-mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--gold-deep);
    border-radius: 50%;
    color: var(--gold-deep);
    font: 600 0.75rem var(--body);
  }
  .contacts__metro p {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
  }
  .contacts__metro strong {
    font: 400 1.125rem var(--display);
  }
  .contacts__metro span,
  .contacts__directions {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .contacts__directions {
    max-width: 48ch;
    margin: 0 0 18px 42px;
    line-height: 1.55;
  }
  .contacts__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .contacts__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .contacts__label {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contacts__value {
    font: 400 1.25rem var(--display);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .contacts__value i {
    color: var(--gold-deep);
    font-style: normal;
    font-size: 1rem;
  }
  .contacts-map {
    border-top: 1px solid var(--line);
  }
  .contacts-map :global(iframe) {
    display: block;
    width: 100%;
    height: 480px;
    border: 0;
  }
  .contacts-map__trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 240px;
    background: var(--paper);
    color: var(--gold-deep);
    font: 400 1.125rem var(--display);
    border: 0;
  }
  .contacts-map__trigger:hover {
    background: var(--sand);
  }

  @media (max-width: 800px) {
    .contacts {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
